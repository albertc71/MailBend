def tool_defs.mail_create_folder() -> String:
  String.concat([
    "{\"name\":\"mail_create_folder\",\"description\":\"Create a folder and ",
    "subscribe to it (if only the subscription fails, the call succeeds with ",
    "subscribed: false; do not retry); on iCloud a folder works as a label ",
    "(see mail_label). The parent folder must already exist, the name must ",
    "not be taken, and it cannot be INBOX, Drafts, Sent, Trash, Junk, Archive ",
    "(by any usual name), a configured or advertised role folder, or inside ",
    "one. The review folder \\\"To Delete\\\" may be created only at top ",
    "level. There is no tool to delete a folder: do that in Apple Mail or ",
    "iCloud.com.\",\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"name\":{\"type\":\"string\",\"description\":\"The new ",
    "folder's full name, levels separated by the server's delimiter (see ",
    "mail_list_folders).\"},\"dry_run\":{\"type\":\"boolean\",",
    "\"description\":\"Only show what this call would do: return the IMAP ",
    "commands, the SMTP sender and recipients with sent_copy (whether ",
    "MAILBEND_SAVE_SENT would save a Sent copy), or the file it would use, ",
    "with message and file contents as <N bytes>. Nothing is changed, sent or ",
    "saved. It is not a full pre-check: marking and flagging make no ",
    "connection, so a stale uidvalidity fails only the real call, and a send ",
    "does not check the daily limit. With MAILBEND_TYPESAFE on, a send or ",
    "delete still passes Jev's checks and shows their verdict. Default ",
    "false.\"}},\"required\":[\"name\"],\"additionalProperties\":false},",
    "\"outputSchema\":{\"type\":\"object\",\"anyOf\":[{\"type\":\"object\",",
    "\"properties\":{\"error\":{\"type\":\"string\"}},",
    "\"required\":[\"error\"],\"additionalProperties\":false},",
    "{\"type\":\"object\",\"properties\":{\"ok\":{\"const\":true},",
    "\"folder\":{\"type\":\"string\"},\"subscribed\":{\"type\":\"boolean\"},",
    "\"note\":{\"type\":\"string\"}},\"required\":[\"ok\",\"folder\",",
    "\"subscribed\"],\"additionalProperties\":false},{\"type\":\"object\",",
    "\"properties\":{\"dry_run\":{\"const\":true},",
    "\"imap\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},",
    "\"required\":[\"dry_run\",\"imap\"],\"additionalProperties\":false}]},",
    "\"annotations\":{\"readOnlyHint\":false,\"destructiveHint\":false,",
    "\"idempotentHint\":false,\"openWorldHint\":false}}"])

def tool_defs.mail_rename_folder() -> String:
  String.concat([
    "{\"name\":\"mail_rename_folder\",\"description\":\"Rename a folder ",
    "together with its subfolders, and move the subscriptions of the folder ",
    "and of its subscribed subfolders to their new names. If only the ",
    "subscriptions fail, the call succeeds with subscribed: false; do not ",
    "retry. If the connection drops before the answer, the folder may have ",
    "been renamed: list folders before retrying. The same name rules as ",
    "mail_create_folder apply to the new name and to every subfolder's new ",
    "path, and a folder that is or contains INBOX, Drafts, Sent, Trash, Junk, ",
    "Archive or another role folder cannot be renamed.\",",
    "\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"from\":{\"type\":\"string\",\"description\":\"Current ",
    "full folder name.\"},\"to\":{\"type\":\"string\",\"description\":\"New ",
    "full folder name; its parent must already exist.\"},",
    "\"dry_run\":{\"type\":\"boolean\",\"description\":\"Only show what this ",
    "call would do: return the IMAP commands, the SMTP sender and recipients ",
    "with sent_copy (whether MAILBEND_SAVE_SENT would save a Sent copy), or ",
    "the file it would use, with message and file contents as <N bytes>. ",
    "Nothing is changed, sent or saved. It is not a full pre-check: marking ",
    "and flagging make no connection, so a stale uidvalidity fails only the ",
    "real call, and a send does not check the daily limit. With ",
    "MAILBEND_TYPESAFE on, a send or delete still passes Jev's checks and ",
    "shows their verdict. Default false.\"}},\"required\":[\"from\",\"to\"],",
    "\"additionalProperties\":false},\"outputSchema\":{\"type\":\"object\",",
    "\"anyOf\":[{\"type\":\"object\",",
    "\"properties\":{\"error\":{\"type\":\"string\"}},",
    "\"required\":[\"error\"],\"additionalProperties\":false},",
    "{\"type\":\"object\",\"properties\":{\"ok\":{\"const\":true},",
    "\"from\":{\"type\":\"string\"},\"to\":{\"type\":\"string\"},",
    "\"subscribed\":{\"type\":\"boolean\"},\"note\":{\"type\":\"string\"}},",
    "\"required\":[\"ok\",\"from\",\"to\",\"subscribed\"],",
    "\"additionalProperties\":false},{\"type\":\"object\",",
    "\"properties\":{\"dry_run\":{\"const\":true},",
    "\"imap\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},",
    "\"required\":[\"dry_run\",\"imap\"],\"additionalProperties\":false}]},",
    "\"annotations\":{\"readOnlyHint\":false,\"destructiveHint\":false,",
    "\"idempotentHint\":false,\"openWorldHint\":false}}"])

def tool_defs.mail_save_draft() -> String:
  String.concat([
    "{\"name\":\"mail_save_draft\",\"description\":\"Compose a message and ",
    "save it to the resolved drafts folder (configured override, advertised ",
    "special use, or unique conventional name) without sending. Preserves Bcc ",
    "recipients in the draft.\",\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"to\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"string\"},\"description\":\"Addresses like ",
    "name@example.com or \\\"Name <name@example.com>\\\".\"},",
    "\"cc\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},",
    "\"description\":\"Addresses like name@example.com or \\\"Name ",
    "<name@example.com>\\\".\"},\"bcc\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"string\"},\"description\":\"Blind copies: retained ",
    "in saved drafts; sent messages include them only in the SMTP ",
    "envelope.\"},\"subject\":{\"type\":\"string\"},",
    "\"body\":{\"type\":\"string\",\"description\":\"Plain-text body.\"},",
    "\"in_reply_to\":{\"type\":\"string\",\"description\":\"Message-ID this ",
    "answers (sets In-Reply-To).\"},\"references\":{\"type\":\"string\",",
    "\"description\":\"References header value.\"},",
    "\"attachments\":{\"type\":\"array\",\"description\":\"Files to attach. ",
    "Only regular files inside MAILBEND_ATTACH_DIR are allowed; attachments ",
    "are off when it is not set.\",\"items\":{\"type\":\"object\",",
    "\"required\":[\"path\"],\"additionalProperties\":false,",
    "\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"A file ",
    "in MAILBEND_ATTACH_DIR: relative to it, or absolute inside it (max 25 ",
    "MB, no symlinks).\"},\"filename\":{\"type\":\"string\",",
    "\"description\":\"Name shown to the recipient. Default: the file ",
    "name.\"},\"content_type\":{\"type\":\"string\",\"description\":\"MIME ",
    "type. Default: guessed from the extension.\"}}}},",
    "\"dry_run\":{\"type\":\"boolean\",\"description\":\"Only show what this ",
    "call would do: return the IMAP commands, the SMTP sender and recipients ",
    "with sent_copy (whether MAILBEND_SAVE_SENT would save a Sent copy), or ",
    "the file it would use, with message and file contents as <N bytes>. ",
    "Nothing is changed, sent or saved. It is not a full pre-check: marking ",
    "and flagging make no connection, so a stale uidvalidity fails only the ",
    "real call, and a send does not check the daily limit. With ",
    "MAILBEND_TYPESAFE on, a send or delete still passes Jev's checks and ",
    "shows their verdict. Default false.\"}},\"required\":[],",
    "\"additionalProperties\":false},\"outputSchema\":{\"type\":\"object\",",
    "\"anyOf\":[{\"type\":\"object\",",
    "\"properties\":{\"error\":{\"type\":\"string\"}},",
    "\"required\":[\"error\"],\"additionalProperties\":false},",
    "{\"type\":\"object\",\"properties\":{\"ok\":{\"const\":true},",
    "\"saved_to\":{\"type\":\"string\"},\"uid\":{\"type\":[\"integer\",",
    "\"null\"],\"minimum\":0},\"message_id\":{\"type\":\"string\"}},",
    "\"required\":[\"ok\",\"saved_to\",\"uid\",\"message_id\"],",
    "\"additionalProperties\":false},{\"type\":\"object\",",
    "\"properties\":{\"dry_run\":{\"const\":true},",
    "\"imap\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},",
    "\"required\":[\"dry_run\",\"imap\"],\"additionalProperties\":false}]},",
    "\"annotations\":{\"readOnlyHint\":false,\"destructiveHint\":false,",
    "\"idempotentHint\":false,\"openWorldHint\":false}}"])

def tool_defs.mail_send() -> String:
  String.concat([
    "{\"name\":\"mail_send\",\"description\":\"Compose and send a message ",
    "over SMTP (verified TLS). From is MAILBEND_EMAIL. A send is refused, and ",
    "nothing is sent, when a recipient is not in MAILBEND_ALLOWED_RECIPIENTS ",
    "or the MAILBEND_MAX_SENDS_PER_DAY limit is reached. With ",
    "MAILBEND_SAVE_SENT the result's sent_copy says whether a copy was saved ",
    "to the Sent folder; a failed copy does not fail the send. SMTP attempts ",
    "report smtp_outcome (accepted, not_sent, unknown), smtp_phase, ",
    "smtp_reason and next_action. Accepted means accepted by the SMTP server, ",
    "not recipient delivery. Never automatically retry unknown; a missing ",
    "Sent copy does not prove non-delivery. With MAILBEND_TYPESAFE on, the ",
    "message is first scanned locally for secrets, then checked by Jev; a ",
    "secret, unreadable text, a Jev block or a TypeSafe failure stops the ",
    "send (the result has secret_scan and jev). Saving a draft ",
    "(mail_save_draft) is never checked.\",",
    "\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"to\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"string\"},\"description\":\"Addresses like ",
    "name@example.com or \\\"Name <name@example.com>\\\".\"},",
    "\"cc\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},",
    "\"description\":\"Addresses like name@example.com or \\\"Name ",
    "<name@example.com>\\\".\"},\"bcc\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"string\"},\"description\":\"Blind copies: retained ",
    "in saved drafts; sent messages include them only in the SMTP ",
    "envelope.\"},\"subject\":{\"type\":\"string\"},",
    "\"body\":{\"type\":\"string\",\"description\":\"Plain-text body.\"},",
    "\"in_reply_to\":{\"type\":\"string\",\"description\":\"Message-ID this ",
    "answers (sets In-Reply-To).\"},\"references\":{\"type\":\"string\",",
    "\"description\":\"References header value.\"},",
    "\"attachments\":{\"type\":\"array\",\"description\":\"Files to attach. ",
    "Only regular files inside MAILBEND_ATTACH_DIR are allowed; attachments ",
    "are off when it is not set.\",\"items\":{\"type\":\"object\",",
    "\"required\":[\"path\"],\"additionalProperties\":false,",
    "\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"A file ",
    "in MAILBEND_ATTACH_DIR: relative to it, or absolute inside it (max 25 ",
    "MB, no symlinks).\"},\"filename\":{\"type\":\"string\",",
    "\"description\":\"Name shown to the recipient. Default: the file ",
    "name.\"},\"content_type\":{\"type\":\"string\",\"description\":\"MIME ",
    "type. Default: guessed from the extension.\"}}}},",
    "\"dry_run\":{\"type\":\"boolean\",\"description\":\"Only show what this ",
    "call would do: return the IMAP commands, the SMTP sender and recipients ",
    "with sent_copy (whether MAILBEND_SAVE_SENT would save a Sent copy), or ",
    "the file it would use, with message and file contents as <N bytes>. ",
    "Nothing is changed, sent or saved. It is not a full pre-check: marking ",
    "and flagging make no connection, so a stale uidvalidity fails only the ",
    "real call, and a send does not check the daily limit. With ",
    "MAILBEND_TYPESAFE on, a send or delete still passes Jev's checks and ",
    "shows their verdict. Default false.\"}},\"required\":[],",
    "\"additionalProperties\":false},\"outputSchema\":{\"type\":\"object\",",
    "\"anyOf\":[{\"type\":\"object\",",
    "\"properties\":{\"error\":{\"type\":\"string\"}},",
    "\"required\":[\"error\"],\"additionalProperties\":false},",
    "{\"type\":\"object\",\"properties\":{\"ok\":{\"const\":true},",
    "\"sent\":{\"const\":true},\"message_id\":{\"type\":\"string\"},",
    "\"recipients\":{\"type\":\"integer\",\"minimum\":0},",
    "\"server_reply\":{\"type\":\"string\"},\"jev\":{\"type\":\"object\",",
    "\"properties\":{\"status\":{\"type\":\"string\",\"enum\":[\"checked\",",
    "\"unchecked\"]},\"model\":{\"type\":\"string\"},",
    "\"content\":{\"type\":\"string\",\"enum\":[\"headers\",\"body\"]},",
    "\"derived_from_untrusted_content\":{\"const\":true},",
    "\"decision\":{\"type\":\"string\",\"enum\":[\"proceeded\",\"blocked\"]},",
    "\"reasons\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},",
    "\"signals\":{\"type\":\"object\",",
    "\"properties\":{\"reply_needed\":{\"type\":\"string\",\"enum\":[\"low\",",
    "\"mid\",\"high\",\"unknown\"]},\"action_required\":{\"type\":\"string\",",
    "\"enum\":[\"low\",\"mid\",\"high\",\"unknown\"]},",
    "\"deadline_present\":{\"type\":\"string\",\"enum\":[\"low\",\"mid\",",
    "\"high\",\"unknown\"]},\"priority\":{\"type\":\"string\",",
    "\"enum\":[\"low\",\"mid\",\"high\",\"unknown\"]},",
    "\"disposable\":{\"type\":\"string\",\"enum\":[\"low\",\"mid\",\"high\",",
    "\"unknown\"]},\"suggested_action\":{\"type\":\"string\"},",
    "\"keep\":{\"type\":\"object\",",
    "\"properties\":{\"record\":{\"type\":\"string\",\"enum\":[\"low\",",
    "\"mid\",\"high\",\"unknown\"]},\"security\":{\"type\":\"string\",",
    "\"enum\":[\"low\",\"mid\",\"high\",\"unknown\"]},",
    "\"personal\":{\"type\":\"string\",\"enum\":[\"low\",\"mid\",\"high\",",
    "\"unknown\"]},\"open_action\":{\"type\":\"string\",\"enum\":[\"low\",",
    "\"mid\",\"high\",\"unknown\"]},\"needed_again\":{\"type\":\"string\",",
    "\"enum\":[\"low\",\"mid\",\"high\",\"unknown\"]}},",
    "\"required\":[\"record\",\"security\",\"personal\",\"open_action\",",
    "\"needed_again\"],\"additionalProperties\":false},",
    "\"suspected_injection\":{\"const\":true},",
    "\"category\":{\"type\":[\"string\",\"null\"]},",
    "\"new_category\":{\"type\":\"string\"},",
    "\"needs_new_category\":{\"const\":true}},",
    "\"additionalProperties\":{\"type\":\"string\",\"enum\":[\"low\",\"mid\",",
    "\"high\",\"unknown\"]}}},\"required\":[\"status\",\"model\",\"content\",",
    "\"derived_from_untrusted_content\",\"decision\",\"reasons\",\"signals\"],",
    "\"additionalProperties\":false},\"body_truncated\":{\"const\":true},",
    "\"secret_scan\":{\"type\":\"string\",\"enum\":[\"clean\",\"found\",",
    "\"incomplete\"]},\"sent_copy\":{\"type\":\"string\"}},",
    "\"required\":[\"ok\",\"sent\",\"message_id\",\"recipients\",",
    "\"server_reply\"],\"additionalProperties\":false},{\"type\":\"object\",",
    "\"properties\":{\"ok\":{\"const\":true},\"sent\":{\"const\":true},",
    "\"message_id\":{\"type\":\"string\"},",
    "\"recipients\":{\"type\":\"integer\",\"minimum\":0},",
    "\"server_reply\":{\"type\":\"string\"},\"jev\":{\"type\":\"object\",",
    "\"properties\":{\"status\":{\"type\":\"string\",\"enum\":[\"checked\",",
