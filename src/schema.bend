def tool_defs.mail_refresh() -> String:
  String.concat([
    "{\"name\":\"mail_refresh\",\"description\":\"Refresh known message UIDs ",
    "in one read-only session. Returns present UIDs with flags, absent UIDs ",
    "proved absent in this mailbox by SEARCH, and unknown UIDs when evidence ",
    "is incomplete. Protocol/transport/limit failures are tool errors ",
    "retaining these fields. Absence is not global deletion. Missing FETCH ",
    "never proves absence. complete is false for unknown evidence or ",
    "reset_required; on reset discard the mailbox's cached UIDs. Stateless, ",
    "not a snapshot; combine with mail_get_new. At most 100 supplied UIDs, ",
    "sorted and deduplicated; empty is refused. One session, three commands, ",
    "256 KiB helper output and result, 30 seconds. No content or Jev calls.\",",
    "\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"folder\":{\"type\":\"string\",",
    "\"description\":\"Mailbox name; at most 1024 UTF-8 bytes. Default ",
    "INBOX.\"},\"uids\":{\"type\":\"array\",\"items\":{\"type\":\"integer\",",
    "\"minimum\":1,\"maximum\":4294967295},\"minItems\":1,\"maxItems\":100},",
    "\"uidvalidity\":{\"type\":\"integer\",\"minimum\":1,",
    "\"maximum\":4294967295,\"description\":\"Expected mailbox identity from ",
    "earlier reads.\"}},\"required\":[\"uids\",\"uidvalidity\"],",
    "\"additionalProperties\":false},\"outputSchema\":{\"type\":\"object\",",
    "\"anyOf\":[{\"type\":\"object\",",
    "\"properties\":{\"error\":{\"type\":\"string\"}},",
    "\"required\":[\"error\"],\"additionalProperties\":false},",
    "{\"type\":\"object\",\"properties\":{\"folder\":{\"type\":\"string\"},",
    "\"uidvalidity\":{\"type\":[\"integer\",\"null\"],\"minimum\":0},",
    "\"reset_required\":{\"type\":\"boolean\"},",
    "\"complete\":{\"type\":\"boolean\"},\"present\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"object\",",
    "\"properties\":{\"uid\":{\"type\":\"integer\",\"minimum\":0},",
    "\"flags\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},",
    "\"required\":[\"uid\",\"flags\"],\"additionalProperties\":false}},",
    "\"absent\":{\"type\":\"array\",\"items\":{\"type\":\"integer\",",
    "\"minimum\":0}},\"unknown\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":0}},",
    "\"reason\":{\"type\":\"string\"}},\"required\":[\"folder\",",
    "\"uidvalidity\",\"reset_required\",\"complete\",\"present\",\"absent\",",
    "\"unknown\",\"reason\"],\"additionalProperties\":false}]},",
    "\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,",
    "\"idempotentHint\":true,\"openWorldHint\":false}}"])

def tool_defs.mail_get_thread() -> String:
  String.concat([
    "{\"name\":\"mail_get_thread\",\"description\":\"Read the conversation a ",
    "message belongs to, oldest first (by INTERNALDATE, then UID): the ",
    "messages in its folder, INBOX and the resolved Sent folder that are ",
    "linked to it by Message-ID, In-Reply-To and References, each with its ",
    "folder, uidvalidity and parent (the Message-ID of the message it answers ",
    "in the thread, or null). Messages are never grouped by subject. Two ",
    "rounds of linked IDs are searched, at most 50 IDs each, so a long thread ",
    "can be cut short; searched lists the folders. Changes nothing: messages ",
    "stay unread. With MAILBEND_TYPESAFE on, each message also has a jev ",
    "object with Jev's notes (reply_needed, action_required, priority, ",
    "category, suggested_action, and suspected_injection when suspected), ",
    "drawn from untrusted mail content; its status is unchecked when TypeSafe ",
    "failed.\",\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"folder\":{\"type\":\"string\",\"description\":\"Folder ",
    "(IMAP mailbox) name. Default: INBOX.\"},\"uid\":{\"type\":\"integer\",",
    "\"minimum\":1},\"uidvalidity\":{\"type\":\"integer\",\"minimum\":1,",
    "\"maximum\":4294967295,\"description\":\"Optional UIDVALIDITY of the ",
    "seed folder returned with its UID. Checked in the seed read session ",
    "before any message fetch; mismatch returns no content and makes no Jev ",
    "request. Later thread sessions pin each folder's own discovered ",
    "UIDVALIDITY. Omit to preserve legacy behavior.\"},",
    "\"projection\":{\"type\":\"string\",\"enum\":[\"full\",\"text\",\"html\",",
    "\"metadata\"],\"description\":\"Body fields to return; default full ",
    "preserves text and HTML. text omits html, html omits text, metadata ",
    "omits both. Headers, summaries, identity, completeness and Jev stay ",
    "unchanged. Selected-part content follows its MIME type: text keeps ",
    "text/* except text/html, html keeps text/html, metadata omits content. ",
    "Does not change fetching or Jev input.\"},",
    "\"max_response_bytes\":{\"type\":\"integer\",\"minimum\":1,",
    "\"maximum\":16777216,\"description\":\"Optional UTF-8 byte budget for ",
    "shared result JSON, including JSON escaping; excludes CLI newline and ",
    "MCP envelope/escaping. No default limit. Only body strings are ",
    "shortened; selected binary content is kept whole or replaced by empty ",
    "valid base64, never sliced. Selected-part response.content_complete ",
    "describes returned content; complete remains fetched-part completeness. ",
    "All summaries/cursors/Jev results remain; an impossible budget is an ",
    "error (errors are outside the budget). Retry with a larger budget or ",
    "smaller limit and the same checkpoint. response.output_truncated is ",
    "separate from fetched-message truncated.\"}},\"required\":[\"uid\"],",
    "\"additionalProperties\":false},\"outputSchema\":{\"type\":\"object\",",
    "\"anyOf\":[{\"type\":\"object\",",
    "\"properties\":{\"error\":{\"type\":\"string\"}},",
    "\"required\":[\"error\"],\"additionalProperties\":false},",
    "{\"type\":\"object\",\"properties\":{\"folder\":{\"type\":\"string\"},",
    "\"uid\":{\"type\":\"integer\",\"minimum\":0},",
    "\"searched\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},",
    "\"messages\":{\"type\":\"array\",\"items\":{\"type\":\"object\",",
    "\"properties\":{\"date\":{\"type\":\"string\"},",
    "\"from\":{\"type\":\"string\"},\"to\":{\"type\":\"string\"},",
    "\"cc\":{\"type\":\"string\"},\"subject\":{\"type\":\"string\"},",
    "\"message_id\":{\"type\":\"string\"},",
    "\"internal_date\":{\"type\":\"string\"},\"uid\":{\"type\":\"integer\",",
    "\"minimum\":0},\"size\":{\"type\":\"integer\",\"minimum\":0},",
    "\"flags\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},",
    "\"seen\":{\"type\":\"boolean\"},\"flagged\":{\"type\":\"boolean\"},",
    "\"folder\":{\"type\":\"string\"},\"uidvalidity\":{\"type\":[\"integer\",",
    "\"null\"],\"minimum\":0},\"parent\":{\"type\":[\"string\",\"null\"]},",
    "\"jev\":{\"type\":\"object\",",
    "\"properties\":{\"status\":{\"type\":\"string\",\"enum\":[\"checked\",",
    "\"unchecked\"]},\"model\":{\"type\":\"string\"},",
    "\"content\":{\"type\":\"string\",\"enum\":[\"headers\",\"body\"]},",
    "\"derived_from_untrusted_content\":{\"const\":true},",
    "\"decision\":{\"type\":\"string\",\"enum\":[\"proceeded\",\"blocked\"]},",
    "\"reasons\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},",
    "\"signals\":{\"type\":\"object\",",
    "\"properties\":{\"reply_needed\":{\"type\":\"string\",\"enum\":[\"low\",",
    "\"mid\",\"high\",\"unknown\"]},\"action_required\":{\"type\":\"string\",",
    "\"enum\":[\"low\",\"mid\",\"high\",\"unknown\"]},",
    "\"deadline_present\":{\"type\":\"string\",\"enum\":[\"low\",\"mid\",",
    "\"high\",\"unknown\"]},\"priority\":{\"type\":\"string\",",
