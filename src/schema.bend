def tool_defs.mail_flag() -> String:
  String.concat([
    "{\"name\":\"mail_flag\",\"description\":\"Flag messages (add ",
    "\\\\Flagged). With a colour, also set exactly that Apple Mail colour's ",
    "$MailFlagBit0-2 keywords and clear the others (red has none); without ",
    "one, the current colour is kept. With a colour the result has ",
    "colour_kept: true; false when a message shows other flags or ",
    "PERMANENTFLAGS says a change lasts only for this session ",
    "(colour_not_kept lists those UIDs); or \\\"unverified\\\" when the ",
    "server sent no PERMANENTFLAGS or no flags for a message. flags lists ",
    "each changed UID's flags as the server reported them after the change ",
    "(null if it reported none). If the change stops once a store was ",
    "acknowledged or sent unanswered (or the TLS helper is lost after ",
    "starting), the call fails with partial: true, listing the acknowledged ",
    "changes and those that may have run unanswered; a retry is idempotent ",
    "but may fail again on a server that refuses the colour keywords. A ",
    "change that stopped before any store could run, or whose UIDs none ",
    "exist, is a plain error.\",\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"folder\":{\"type\":\"string\",\"description\":\"Folder ",
    "(IMAP mailbox) name. Default: INBOX.\"},\"uids\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":1},\"minItems\":1,",
    "\"description\":\"Message UIDs in the folder (from mail_search or ",
    "mail_get_new).\"},\"uidvalidity\":{\"type\":\"integer\",\"minimum\":1,",
    "\"description\":\"The folder's UIDVALIDITY returned with the UIDs ",
    "(mail_search, mail_get, mail_get_new). Checked in the same session as ",
    "the change; if the folder changed since, nothing is changed.\"},",
    "\"colour\":{\"type\":\"string\",\"enum\":[\"red\",\"orange\",\"yellow\",",
    "\"green\",\"blue\",\"purple\",\"grey\"],\"description\":\"Flag colour. ",
    "Omit it to keep the current colour.\"},\"dry_run\":{\"type\":\"boolean\",",
    "\"description\":\"Only show what this call would do: return the IMAP ",
    "commands, the SMTP sender and recipients with sent_copy (whether ",
    "MAILBEND_SAVE_SENT would save a Sent copy), or the file it would use, ",
    "with message and file contents as <N bytes>. Nothing is changed, sent or ",
    "saved. It is not a full pre-check: marking and flagging make no ",
    "connection, so a stale uidvalidity fails only the real call, and a send ",
    "does not check the daily limit. Default false.\"}},",
    "\"required\":[\"uids\",\"uidvalidity\"],\"additionalProperties\":false},",
    "\"annotations\":{\"readOnlyHint\":false,\"destructiveHint\":false,",
    "\"idempotentHint\":true,\"openWorldHint\":false}}"])

def tool_defs.mail_unflag() -> String:
  String.concat([
    "{\"name\":\"mail_unflag\",\"description\":\"Unflag messages: remove ",
    "\\\\Flagged, then clear every colour keyword. flags lists each changed ",
    "UID's flags as the server reported them after the change (null if it ",
    "reported none). If the change stops once a store was acknowledged or ",
    "sent unanswered (or the TLS helper is lost after starting), the call ",
    "fails with partial: true, listing the acknowledged changes and those ",
    "that may have run unanswered; a retry is idempotent but may fail again ",
    "on a server that refuses the colour keywords. A change that stopped ",
    "before any store could run, or whose UIDs none exist, is a plain ",
    "error.\",\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"folder\":{\"type\":\"string\",\"description\":\"Folder ",
    "(IMAP mailbox) name. Default: INBOX.\"},\"uids\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":1},\"minItems\":1,",
    "\"description\":\"Message UIDs in the folder (from mail_search or ",
    "mail_get_new).\"},\"uidvalidity\":{\"type\":\"integer\",\"minimum\":1,",
    "\"description\":\"The folder's UIDVALIDITY returned with the UIDs ",
    "(mail_search, mail_get, mail_get_new). Checked in the same session as ",
    "the change; if the folder changed since, nothing is changed.\"},",
    "\"dry_run\":{\"type\":\"boolean\",\"description\":\"Only show what this ",
    "call would do: return the IMAP commands, the SMTP sender and recipients ",
    "with sent_copy (whether MAILBEND_SAVE_SENT would save a Sent copy), or ",
    "the file it would use, with message and file contents as <N bytes>. ",
    "Nothing is changed, sent or saved. It is not a full pre-check: marking ",
    "and flagging make no connection, so a stale uidvalidity fails only the ",
    "real call, and a send does not check the daily limit. Default false.\"}},",
    "\"required\":[\"uids\",\"uidvalidity\"],\"additionalProperties\":false},",
    "\"annotations\":{\"readOnlyHint\":false,\"destructiveHint\":false,",
    "\"idempotentHint\":true,\"openWorldHint\":false}}"])

def tool_defs.mail_move() -> String:
  String.concat([
    "{\"name\":\"mail_move\",\"description\":\"Move messages to another IMAP ",
    "folder. Uses UID MOVE, or copy + expunge of exactly these UIDs with ",
    "UIDPLUS. If the move is cut off after the copy may have run, the call ",
    "fails with partial: true and the messages may be in both folders, so ",
    "check the destination before retrying.\",",
    "\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"folder\":{\"type\":\"string\",\"description\":\"Folder ",
    "(IMAP mailbox) name. Default: INBOX.\"},\"uids\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":1},\"minItems\":1,",
    "\"description\":\"Message UIDs in the folder (from mail_search or ",
    "mail_get_new).\"},\"destination\":{\"type\":\"string\",",
    "\"description\":\"Target folder name.\"},",
    "\"uidvalidity\":{\"type\":\"integer\",\"minimum\":1,",
    "\"description\":\"The folder's UIDVALIDITY returned with the UIDs ",
    "(mail_search, mail_get, mail_get_new). Checked in the same session as ",
    "the change; if the folder changed since, nothing is changed.\"},",
    "\"dry_run\":{\"type\":\"boolean\",\"description\":\"Only show what this ",
    "call would do: return the IMAP commands, the SMTP sender and recipients ",
    "with sent_copy (whether MAILBEND_SAVE_SENT would save a Sent copy), or ",
    "the file it would use, with message and file contents as <N bytes>. ",
    "Nothing is changed, sent or saved. It is not a full pre-check: marking ",
    "and flagging make no connection, so a stale uidvalidity fails only the ",
    "real call, and a send does not check the daily limit. Default false.\"}},",
    "\"required\":[\"uids\",\"destination\",\"uidvalidity\"],",
    "\"additionalProperties\":false},\"annotations\":{\"readOnlyHint\":false,",
    "\"destructiveHint\":false,\"idempotentHint\":false,",
    "\"openWorldHint\":false}}"])

def tool_defs.mail_label() -> String:
  String.concat([
    "{\"name\":\"mail_label\",\"description\":\"Label messages: move them ",
    "into an existing label folder (create one with mail_create_folder). On ",
    "iCloud a label is a folder, so a message has one label and exists once; ",
    "mail_move back to INBOX removes it. Refuses INBOX, Drafts, Sent, Trash, ",
    "Junk, Archive and the other role folders. If the move is cut off after ",
    "the copy may have run, the call fails with partial: true and the ",
    "messages may be in both folders, so check the destination before ",
    "retrying.\",\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"folder\":{\"type\":\"string\",\"description\":\"Folder ",
    "(IMAP mailbox) name. Default: INBOX.\"},\"uids\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":1},\"minItems\":1,",
    "\"description\":\"Message UIDs in the folder (from mail_search or ",
    "mail_get_new).\"},\"label\":{\"type\":\"string\",\"description\":\"Name ",
    "of an existing folder to use as the label.\"},",
    "\"uidvalidity\":{\"type\":\"integer\",\"minimum\":1,",
    "\"description\":\"The folder's UIDVALIDITY returned with the UIDs ",
    "(mail_search, mail_get, mail_get_new). Checked in the same session as ",
    "the change; if the folder changed since, nothing is changed.\"},",
    "\"dry_run\":{\"type\":\"boolean\",\"description\":\"Only show what this ",
    "call would do: return the IMAP commands, the SMTP sender and recipients ",
    "with sent_copy (whether MAILBEND_SAVE_SENT would save a Sent copy), or ",
    "the file it would use, with message and file contents as <N bytes>. ",
    "Nothing is changed, sent or saved. It is not a full pre-check: marking ",
    "and flagging make no connection, so a stale uidvalidity fails only the ",
    "real call, and a send does not check the daily limit. Default false.\"}},",
    "\"required\":[\"uids\",\"label\",\"uidvalidity\"],",
    "\"additionalProperties\":false},\"annotations\":{\"readOnlyHint\":false,",
    "\"destructiveHint\":false,\"idempotentHint\":false,",
    "\"openWorldHint\":false}}"])

def tool_defs.mail_trash() -> String:
  String.concat([
    "{\"name\":\"mail_trash\",\"description\":\"Move messages to the resolved ",
    "trash folder (configured override, advertised special use, or unique ",
    "conventional name). Recoverable; does not delete permanently. If the ",
    "move is cut off after the copy may have run, the call fails with ",
    "partial: true and the messages may be in both folders, so check the ",
    "destination before retrying.\",\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"folder\":{\"type\":\"string\",\"description\":\"Folder ",
    "(IMAP mailbox) name. Default: INBOX.\"},\"uids\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":1},\"minItems\":1,",
    "\"description\":\"Message UIDs in the folder (from mail_search or ",
    "mail_get_new).\"},\"uidvalidity\":{\"type\":\"integer\",\"minimum\":1,",
    "\"description\":\"The folder's UIDVALIDITY returned with the UIDs ",
    "(mail_search, mail_get, mail_get_new). Checked in the same session as ",
    "the change; if the folder changed since, nothing is changed.\"},",
    "\"dry_run\":{\"type\":\"boolean\",\"description\":\"Only show what this ",
    "call would do: return the IMAP commands, the SMTP sender and recipients ",
    "with sent_copy (whether MAILBEND_SAVE_SENT would save a Sent copy), or ",
    "the file it would use, with message and file contents as <N bytes>. ",
    "Nothing is changed, sent or saved. It is not a full pre-check: marking ",
    "and flagging make no connection, so a stale uidvalidity fails only the ",
    "real call, and a send does not check the daily limit. Default false.\"}},",
    "\"required\":[\"uids\",\"uidvalidity\"],\"additionalProperties\":false},",
    "\"annotations\":{\"readOnlyHint\":false,\"destructiveHint\":false,",
    "\"idempotentHint\":false,\"openWorldHint\":false}}"])

def tool_defs.mail_delete() -> String:
  String.concat([
    "{\"name\":\"mail_delete\",\"description\":\"PERMANENTLY delete messages ",
    "(\\\\Deleted + UID EXPUNGE of exactly these UIDs). Cannot be undone; ",
    "prefer mail_trash. Requires confirm = \\\"permanently-delete\\\" and the ",
    "folder's uidvalidity. The confirm word guards against mistakes; it is ",
    "not the user's approval, so ask the user first.\",",
    "\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"folder\":{\"type\":\"string\",\"description\":\"Folder ",
    "(IMAP mailbox) name. Default: INBOX.\"},\"uids\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":1},\"minItems\":1,",
    "\"description\":\"Message UIDs in the folder (from mail_search or ",
    "mail_get_new).\"},\"uidvalidity\":{\"type\":\"integer\",\"minimum\":1,",
    "\"description\":\"The folder's UIDVALIDITY returned with the UIDs ",
    "(mail_search, mail_get, mail_get_new). Checked in the same session as ",
    "the change; if the folder changed since, nothing is changed.\"},",
    "\"confirm\":{\"type\":\"string\",\"enum\":[\"permanently-delete\"]},",
    "\"dry_run\":{\"type\":\"boolean\",\"description\":\"Only show what this ",
    "call would do: return the IMAP commands, the SMTP sender and recipients ",
    "with sent_copy (whether MAILBEND_SAVE_SENT would save a Sent copy), or ",
    "the file it would use, with message and file contents as <N bytes>. ",
    "Nothing is changed, sent or saved. It is not a full pre-check: marking ",
    "and flagging make no connection, so a stale uidvalidity fails only the ",
    "real call, and a send does not check the daily limit. Default false.\"}},",
    "\"required\":[\"uids\",\"uidvalidity\",\"confirm\"],",
    "\"additionalProperties\":false},\"annotations\":{\"readOnlyHint\":false,",
    "\"destructiveHint\":true,\"idempotentHint\":false,",
    "\"openWorldHint\":false}}"])

def tool_defs.mail_create_folder() -> String:
  String.concat([
    "{\"name\":\"mail_create_folder\",\"description\":\"Create a folder and ",
    "subscribe to it (if only the subscription fails, the call succeeds with ",
    "subscribed: false; do not retry); on iCloud a folder works as a label ",
    "(see mail_label). The parent folder must already exist, the name must ",
    "not be taken, and it cannot be INBOX, Drafts, Sent, Trash, Junk, Archive ",
    "(by any usual name), a configured or advertised role folder, or inside ",
    "one. The review folder \\\"To Delete\\\" may be created only at top ",
    "level. There is no tool to delete a folder: do that in Apple Mail or ",
    "iCloud.com.\",\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"name\":{\"type\":\"string\",\"description\":\"The new ",
    "folder's full name, levels separated by the server's delimiter (see ",
    "mail_list_folders).\"},\"dry_run\":{\"type\":\"boolean\",",
    "\"description\":\"Only show what this call would do: return the IMAP ",
    "commands, the SMTP sender and recipients with sent_copy (whether ",
    "MAILBEND_SAVE_SENT would save a Sent copy), or the file it would use, ",
    "with message and file contents as <N bytes>. Nothing is changed, sent or ",
    "saved. It is not a full pre-check: marking and flagging make no ",
    "connection, so a stale uidvalidity fails only the real call, and a send ",
    "does not check the daily limit. Default false.\"}},",
    "\"required\":[\"name\"],\"additionalProperties\":false},",
    "\"annotations\":{\"readOnlyHint\":false,\"destructiveHint\":false,",
    "\"idempotentHint\":false,\"openWorldHint\":false}}"])

def tool_defs.mail_rename_folder() -> String:
  String.concat([
    "{\"name\":\"mail_rename_folder\",\"description\":\"Rename a folder ",
    "together with its subfolders, and move the subscriptions of the folder ",
    "and of its subscribed subfolders to their new names. If only the ",
    "subscriptions fail, the call succeeds with subscribed: false; do not ",
    "retry. If the connection drops before the answer, the folder may have ",
    "been renamed: list folders before retrying. The same name rules as ",
    "mail_create_folder apply to the new name and to every subfolder's new ",
    "path, and a folder that is or contains INBOX, Drafts, Sent, Trash, Junk, ",
    "Archive or another role folder cannot be renamed.\",",
    "\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"from\":{\"type\":\"string\",\"description\":\"Current ",
    "full folder name.\"},\"to\":{\"type\":\"string\",\"description\":\"New ",
    "full folder name; its parent must already exist.\"},",
    "\"dry_run\":{\"type\":\"boolean\",\"description\":\"Only show what this ",
    "call would do: return the IMAP commands, the SMTP sender and recipients ",
    "with sent_copy (whether MAILBEND_SAVE_SENT would save a Sent copy), or ",
    "the file it would use, with message and file contents as <N bytes>. ",
    "Nothing is changed, sent or saved. It is not a full pre-check: marking ",
    "and flagging make no connection, so a stale uidvalidity fails only the ",
    "real call, and a send does not check the daily limit. Default false.\"}},",
    "\"required\":[\"from\",\"to\"],\"additionalProperties\":false},",
    "\"annotations\":{\"readOnlyHint\":false,\"destructiveHint\":false,",
    "\"idempotentHint\":false,\"openWorldHint\":false}}"])

def tool_defs.mail_save_draft() -> String:
  String.concat([
    "{\"name\":\"mail_save_draft\",\"description\":\"Compose a message and ",
    "save it to the resolved drafts folder (configured override, advertised ",
    "special use, or unique conventional name) without sending. Preserves Bcc ",
    "recipients in the draft.\",\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"to\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"string\"},\"description\":\"Addresses like ",
    "name@example.com or \\\"Name <name@example.com>\\\".\"},",
    "\"cc\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},",
    "\"description\":\"Addresses like name@example.com or \\\"Name ",
    "<name@example.com>\\\".\"},\"bcc\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"string\"},\"description\":\"Blind copies: retained ",
    "in saved drafts; sent messages include them only in the SMTP ",
    "envelope.\"},\"subject\":{\"type\":\"string\"},",
    "\"body\":{\"type\":\"string\",\"description\":\"Plain-text body.\"},",
    "\"in_reply_to\":{\"type\":\"string\",\"description\":\"Message-ID this ",
    "answers (sets In-Reply-To).\"},\"references\":{\"type\":\"string\",",
    "\"description\":\"References header value.\"},",
    "\"attachments\":{\"type\":\"array\",\"description\":\"Files to attach. ",
    "Only regular files inside MAILBEND_ATTACH_DIR are allowed; attachments ",
    "are off when it is not set.\",\"items\":{\"type\":\"object\",",
    "\"required\":[\"path\"],\"additionalProperties\":false,",
    "\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"A file ",
    "in MAILBEND_ATTACH_DIR: relative to it, or absolute inside it (max 25 ",
    "MB, no symlinks).\"},\"filename\":{\"type\":\"string\",",
    "\"description\":\"Name shown to the recipient. Default: the file ",
    "name.\"},\"content_type\":{\"type\":\"string\",\"description\":\"MIME ",
    "type. Default: guessed from the extension.\"}}}},",
    "\"dry_run\":{\"type\":\"boolean\",\"description\":\"Only show what this ",
    "call would do: return the IMAP commands, the SMTP sender and recipients ",
    "with sent_copy (whether MAILBEND_SAVE_SENT would save a Sent copy), or ",
    "the file it would use, with message and file contents as <N bytes>. ",
    "Nothing is changed, sent or saved. It is not a full pre-check: marking ",
    "and flagging make no connection, so a stale uidvalidity fails only the ",
    "real call, and a send does not check the daily limit. Default false.\"}},",
    "\"required\":[],\"additionalProperties\":false},",
    "\"annotations\":{\"readOnlyHint\":false,\"destructiveHint\":false,",
    "\"idempotentHint\":false,\"openWorldHint\":false}}"])

def tool_defs.mail_send() -> String:
  String.concat([
    "{\"name\":\"mail_send\",\"description\":\"Compose and send a message ",
    "over SMTP (STARTTLS, verified). From is MAILBEND_EMAIL. A send is ",
    "refused, and nothing is sent, when a recipient is not in ",
    "MAILBEND_ALLOWED_RECIPIENTS or the MAILBEND_MAX_SENDS_PER_DAY limit is ",
    "reached. With MAILBEND_SAVE_SENT the result's sent_copy says whether a ",
    "copy was saved to the Sent folder; a failed copy does not fail the ",
    "send.\",\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"to\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"string\"},\"description\":\"Addresses like ",
    "name@example.com or \\\"Name <name@example.com>\\\".\"},",
    "\"cc\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},",
    "\"description\":\"Addresses like name@example.com or \\\"Name ",
    "<name@example.com>\\\".\"},\"bcc\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"string\"},\"description\":\"Blind copies: retained ",
    "in saved drafts; sent messages include them only in the SMTP ",
    "envelope.\"},\"subject\":{\"type\":\"string\"},",
    "\"body\":{\"type\":\"string\",\"description\":\"Plain-text body.\"},",
    "\"in_reply_to\":{\"type\":\"string\",\"description\":\"Message-ID this ",
    "answers (sets In-Reply-To).\"},\"references\":{\"type\":\"string\",",
    "\"description\":\"References header value.\"},",
    "\"attachments\":{\"type\":\"array\",\"description\":\"Files to attach. ",
    "Only regular files inside MAILBEND_ATTACH_DIR are allowed; attachments ",
    "are off when it is not set.\",\"items\":{\"type\":\"object\",",
    "\"required\":[\"path\"],\"additionalProperties\":false,",
    "\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"A file ",
    "in MAILBEND_ATTACH_DIR: relative to it, or absolute inside it (max 25 ",
    "MB, no symlinks).\"},\"filename\":{\"type\":\"string\",",
    "\"description\":\"Name shown to the recipient. Default: the file ",
    "name.\"},\"content_type\":{\"type\":\"string\",\"description\":\"MIME ",
    "type. Default: guessed from the extension.\"}}}},",
    "\"dry_run\":{\"type\":\"boolean\",\"description\":\"Only show what this ",
    "call would do: return the IMAP commands, the SMTP sender and recipients ",
    "with sent_copy (whether MAILBEND_SAVE_SENT would save a Sent copy), or ",
    "the file it would use, with message and file contents as <N bytes>. ",
    "Nothing is changed, sent or saved. It is not a full pre-check: marking ",
    "and flagging make no connection, so a stale uidvalidity fails only the ",
    "real call, and a send does not check the daily limit. Default false.\"}},",
    "\"required\":[],\"additionalProperties\":false},",
    "\"annotations\":{\"readOnlyHint\":false,\"destructiveHint\":false,",
    "\"idempotentHint\":false,\"openWorldHint\":true}}"])

def tool_defs.mail_reply() -> String:
  String.concat([
    "{\"name\":\"mail_reply\",\"description\":\"Reply to a message (sets ",
    "In-Reply-To/References, quotes the original). Sends unless as_draft is ",
    "true. Only the first 256 KB of the original is read: the result reports ",
    "quoted_original_truncated, quoted_bytes and original_bytes, and a ",
    "truncated quote also says so in the text. A send is refused, and nothing ",
    "is sent, when a recipient is not in MAILBEND_ALLOWED_RECIPIENTS or the ",
    "MAILBEND_MAX_SENDS_PER_DAY limit is reached. With MAILBEND_SAVE_SENT the ",
    "result's sent_copy says whether a copy was saved to the Sent folder; a ",
    "failed copy does not fail the send.\",",
    "\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"folder\":{\"type\":\"string\",\"description\":\"Folder ",
    "(IMAP mailbox) name. Default: INBOX.\"},\"uid\":{\"type\":\"integer\",",
    "\"minimum\":1},\"uidvalidity\":{\"type\":\"integer\",\"minimum\":1,",
    "\"description\":\"The folder's UIDVALIDITY returned with the UIDs ",
    "(mail_search, mail_get, mail_get_new). Checked in the same session as ",
    "the change; if the folder changed since, nothing is changed.\"},",
    "\"body\":{\"type\":\"string\"},\"reply_all\":{\"type\":\"boolean\",",
    "\"description\":\"Also answer the original To and Cc. Default false.\"},",
    "\"bcc\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},",
    "\"description\":\"Addresses like name@example.com or \\\"Name ",
    "<name@example.com>\\\".\"},\"attachments\":{\"type\":\"array\",",
    "\"description\":\"Files to attach. Only regular files inside ",
    "MAILBEND_ATTACH_DIR are allowed; attachments are off when it is not ",
    "set.\",\"items\":{\"type\":\"object\",\"required\":[\"path\"],",
    "\"additionalProperties\":false,",
    "\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"A file ",
    "in MAILBEND_ATTACH_DIR: relative to it, or absolute inside it (max 25 ",
    "MB, no symlinks).\"},\"filename\":{\"type\":\"string\",",
    "\"description\":\"Name shown to the recipient. Default: the file ",
    "name.\"},\"content_type\":{\"type\":\"string\",\"description\":\"MIME ",
    "type. Default: guessed from the extension.\"}}}},",
    "\"as_draft\":{\"type\":\"boolean\",\"description\":\"Save to the ",
    "resolved drafts folder instead of sending; preserves Bcc recipients.\"},",
    "\"dry_run\":{\"type\":\"boolean\",\"description\":\"Only show what this ",
    "call would do: return the IMAP commands, the SMTP sender and recipients ",
    "with sent_copy (whether MAILBEND_SAVE_SENT would save a Sent copy), or ",
    "the file it would use, with message and file contents as <N bytes>. ",
    "Nothing is changed, sent or saved. It is not a full pre-check: marking ",
    "and flagging make no connection, so a stale uidvalidity fails only the ",
    "real call, and a send does not check the daily limit. Default false.\"}},",
    "\"required\":[\"uid\",\"uidvalidity\",\"body\"],",
    "\"additionalProperties\":false},\"annotations\":{\"readOnlyHint\":false,",
    "\"destructiveHint\":false,\"idempotentHint\":false,",
    "\"openWorldHint\":true}}"])

def tool_defs.mail_forward() -> String:
  String.concat([
    "{\"name\":\"mail_forward\",\"description\":\"Forward a message, attached ",
    "whole as a .eml file. Sends unless as_draft is true. A send is refused, ",
    "and nothing is sent, when a recipient is not in ",
    "MAILBEND_ALLOWED_RECIPIENTS or the MAILBEND_MAX_SENDS_PER_DAY limit is ",
    "reached. With MAILBEND_SAVE_SENT the result's sent_copy says whether a ",
    "copy was saved to the Sent folder; a failed copy does not fail the ",
    "send.\",\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"folder\":{\"type\":\"string\",\"description\":\"Folder ",
    "(IMAP mailbox) name. Default: INBOX.\"},\"uid\":{\"type\":\"integer\",",
    "\"minimum\":1},\"uidvalidity\":{\"type\":\"integer\",\"minimum\":1,",
    "\"description\":\"The folder's UIDVALIDITY returned with the UIDs ",
    "(mail_search, mail_get, mail_get_new). Checked in the same session as ",
    "the change; if the folder changed since, nothing is changed.\"},",
    "\"to\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},",
    "\"description\":\"Addresses like name@example.com or \\\"Name ",
    "<name@example.com>\\\".\"},\"cc\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"string\"},\"description\":\"Addresses like ",
    "name@example.com or \\\"Name <name@example.com>\\\".\"},",
    "\"bcc\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},",
    "\"description\":\"Addresses like name@example.com or \\\"Name ",
    "<name@example.com>\\\".\"},\"body\":{\"type\":\"string\",",
    "\"description\":\"Note above the forwarded message.\"},",
    "\"attachments\":{\"type\":\"array\",\"description\":\"Files to attach. ",
    "Only regular files inside MAILBEND_ATTACH_DIR are allowed; attachments ",
    "are off when it is not set.\",\"items\":{\"type\":\"object\",",
    "\"required\":[\"path\"],\"additionalProperties\":false,",
    "\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"A file ",
    "in MAILBEND_ATTACH_DIR: relative to it, or absolute inside it (max 25 ",
    "MB, no symlinks).\"},\"filename\":{\"type\":\"string\",",
    "\"description\":\"Name shown to the recipient. Default: the file ",
    "name.\"},\"content_type\":{\"type\":\"string\",\"description\":\"MIME ",
    "type. Default: guessed from the extension.\"}}}},",
    "\"as_draft\":{\"type\":\"boolean\",\"description\":\"Save to the ",
    "resolved drafts folder instead of sending; preserves Bcc recipients.\"},",
    "\"dry_run\":{\"type\":\"boolean\",\"description\":\"Only show what this ",
    "call would do: return the IMAP commands, the SMTP sender and recipients ",
    "with sent_copy (whether MAILBEND_SAVE_SENT would save a Sent copy), or ",
    "the file it would use, with message and file contents as <N bytes>. ",
    "Nothing is changed, sent or saved. It is not a full pre-check: marking ",
    "and flagging make no connection, so a stale uidvalidity fails only the ",
    "real call, and a send does not check the daily limit. Default false.\"}},",
    "\"required\":[\"uid\",\"uidvalidity\",\"to\"],",
    "\"additionalProperties\":false},\"annotations\":{\"readOnlyHint\":false,",
    "\"destructiveHint\":false,\"idempotentHint\":false,",
    "\"openWorldHint\":true}}"])

# The tool list as one JSON array.
def tool_defs() -> String:
  "[" ++ String.join([
    tool_defs.mail_probe(),
    tool_defs.mail_list_folders(),
    tool_defs.mail_search(),
    tool_defs.mail_get(),
    tool_defs.mail_get_new(),
    tool_defs.mail_get_thread(),
    tool_defs.mail_classify(),
    tool_defs.mail_triage(),
    tool_defs.mail_get_attachment(),
    tool_defs.mail_mark_read(),
    tool_defs.mail_mark_unread(),
    tool_defs.mail_flag(),
    tool_defs.mail_unflag(),
    tool_defs.mail_move(),
    tool_defs.mail_label(),
    tool_defs.mail_trash(),
    tool_defs.mail_delete(),
    tool_defs.mail_create_folder(),
    tool_defs.mail_rename_folder(),
    tool_defs.mail_save_draft(),
    tool_defs.mail_send(),
    tool_defs.mail_reply(),
    tool_defs.mail_forward()], ",") ++ "]"
