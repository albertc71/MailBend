def tool_defs.mail_delete() -> String:
  String.concat([
    "{\"name\":\"mail_delete\",\"description\":\"PERMANENTLY delete messages ",
    "(\\\\Deleted + UID EXPUNGE of exactly these UIDs). Cannot be undone; ",
    "prefer mail_trash. Requires confirm = \\\"permanently-delete\\\", the ",
    "folder's uidvalidity and UIDPLUS on the server. The confirm word guards ",
    "against mistakes; it is not the user's approval, so ask the user first. ",
    "With MAILBEND_TYPESAFE on, it takes at most 50 UIDs, and Jev is first ",
    "asked whether each message should be kept: any high answer, or TypeSafe ",
    "failing, blocks the whole delete (the result has jev). A UID that did ",
    "not exist when Jev was asked is reported in missing, not deleted. Jev ",
    "can only block; it never approves a delete.\",",
    schema_piece.p0010(),
    schema_piece.p0011(),
    schema_piece.p0258(),
    schema_piece.p0259(),
    schema_piece.p0313(),
    schema_piece.p0314(),
    schema_piece.p0273(),
    schema_piece.p0274(),
    schema_piece.p0275(),
    "\"confirm\":{\"type\":\"string\",\"enum\":[\"permanently-delete\"]},",
    schema_piece.p0276(),
    schema_piece.p0277(),
    schema_piece.p0278(),
    schema_piece.p0279(),
    schema_piece.p0280(),
    schema_piece.p0281(),
    schema_piece.p0282(),
    schema_piece.p0283(),
    schema_piece.p0284(),
    "\"uidvalidity\",\"confirm\"],\"additionalProperties\":false},",
    schema_piece.p0008(),
    schema_piece.p0002(),
    schema_piece.p0003(),
    schema_piece.p0004(),
    schema_piece.p0315(),
    schema_piece.p0241(),
    schema_piece.p0316(),
    "\"minimum\":0}},\"permanently_deleted\":{\"const\":true},",
    schema_piece.p0057(),
    schema_piece.p0058(),
    schema_piece.p0059(),
    schema_piece.p0060(),
    schema_piece.p0061(),
    schema_piece.p0062(),
    schema_piece.p0063(),
    schema_piece.p0064(),
    schema_piece.p0065(),
    schema_piece.p0066(),
    schema_piece.p0067(),
    schema_piece.p0068(),
    schema_piece.p0069(),
    schema_piece.p0067(),
    schema_piece.p0070(),
    schema_piece.p0071(),
    schema_piece.p0072(),
    schema_piece.p0073(),
    schema_piece.p0074(),
    schema_piece.p0067(),
    schema_piece.p0075(),
    schema_piece.p0076(),
    schema_piece.p0077(),
    schema_piece.p0078(),
    schema_piece.p0079(),
    schema_piece.p0080(),
    schema_piece.p0081(),
    schema_piece.p0082(),
    schema_piece.p0083(),
    schema_piece.p0084(),
    schema_piece.p0085(),
    schema_piece.p0086(),
    schema_piece.p0087(),
    "\"additionalProperties\":false}},\"required\":[\"ok\",\"folder\",",
    "\"changed\",\"missing\",\"permanently_deleted\"],",
    schema_piece.p0097(),
    schema_piece.p0311(),
    schema_piece.p0339(),
    schema_piece.p0057(),
    schema_piece.p0058(),
    schema_piece.p0059(),
    schema_piece.p0060(),
