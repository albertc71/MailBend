    schema_piece.p0281(),
    schema_piece.p0282(),
    schema_piece.p0283(),
    schema_piece.p0435(),
    "\"uidvalidity\",\"to\"],\"additionalProperties\":false},",
    schema_piece.p0008(),
    schema_piece.p0370(),
    schema_piece.p0371(),
    schema_piece.p0372(),
    schema_piece.p0373(),
    schema_piece.p0374(),
    schema_piece.p0375(),
