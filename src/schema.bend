def tool_defs.mail_get_new() -> String:
  String.concat([
    "{\"name\":\"mail_get_new\",\"description\":\"List messages that arrived ",
    "after a checkpoint (UIDVALIDITY + UID), oldest first. With since_uid 0 ",
    "or no checkpoint, lists the oldest mail. Use start=\\\"now\\\" to take a ",
    "checkpoint at the current end without returning messages. Pass back ",
    "next_since_uid and uidvalidity on the next call. Does not use or change ",
    "read/unread state. With MAILBEND_TYPESAFE on, each message also has a ",
    "jev object with Jev's notes (reply_needed, action_required, priority, ",
    schema_piece.p0186(),
    schema_piece.p0187(),
    schema_piece.p0188(),
    schema_piece.p0011(),
    "(IMAP mailbox) name. Default: INBOX.\"},\"start\":{\"type\":\"string\",",
    "\"enum\":[\"now\"],\"description\":\"Set to now to take a current-end ",
    "checkpoint. Cannot be combined with since_uid. Fails if the server does ",
    "not report valid UIDNEXT and UIDVALIDITY.\"},",
    "\"since_uid\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"Last ",
    "UID already processed. Default 0 lists the oldest mail first.\"},",
    schema_piece.p0189(),
    "\"description\":\"UIDVALIDITY from the previous call; required when ",
    "since_uid is set. If it changed, the checkpoint restarts at 0.\"},",
    "\"limit\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":500,",
    "\"description\":\"Default 50.\"},\"projection\":{\"type\":\"string\",",
