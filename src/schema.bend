def tool_defs.mail_get_new() -> String:
  String.concat([
    "{\"name\":\"mail_get_new\",\"title\":\"Read new mail\",",
    "\"description\":\"List messages that arrived after a checkpoint ",
    "(UIDVALIDITY + UID), oldest first. With since_uid 0 or no checkpoint, ",
    "lists the oldest mail. Use start=\\\"now\\\" to take a checkpoint at the ",
    "current end without returning messages. Pass back next_since_uid and ",
    "uidvalidity on the next call. Does not use or change read/unread state. ",
    schema_piece.p0296(),
    schema_piece.p0297(),
    schema_piece.p0120(),
    schema_piece.p0121(),
    schema_piece.p0011(),
    schema_piece.p0012(),
    "(IMAP mailbox) name. Default: INBOX.\"},\"start\":{\"type\":\"string\",",
    "\"enum\":[\"now\"],\"description\":\"Set to now to take a current-end ",
    "checkpoint. Cannot be combined with since_uid. Fails if the server does ",
    "not report valid UIDNEXT and UIDVALIDITY.\"},",
    "\"since_uid\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"Last ",
    "UID already processed. Default 0 lists the oldest mail first.\"},",
    schema_piece.p0298(),
    "\"description\":\"UIDVALIDITY from the previous call; required when ",
    "since_uid is set. If it changed, the checkpoint restarts at 0.\"},",
    "\"limit\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":500,",
    "\"description\":\"Default 50.\"},\"projection\":{\"type\":\"string\",",
    schema_piece.p0129(),
    schema_piece.p0130(),
    schema_piece.p0131(),
    schema_piece.p0132(),
