def tool_defs.mail_refresh() -> String:
  String.concat([
    "{\"name\":\"mail_refresh\",\"title\":\"Refresh message flags\",",
    "\"description\":\"Refresh known message UIDs in one read-only session. ",
    "Returns present UIDs with flags, absent UIDs proved absent in this ",
    "mailbox by SEARCH, and unknown UIDs when evidence is incomplete. ",
    "Protocol/transport/limit failures are tool errors retaining these ",
    "fields. Absence is not global deletion. Missing FETCH never proves ",
    "absence. complete is false for unknown evidence or reset_required; on ",
    "reset discard the mailbox's cached UIDs. Stateless, not a snapshot; ",
    "combine with mail_get_new. At most 100 supplied UIDs, sorted and ",
    "deduplicated; empty is refused. One session, three commands, 256 KiB ",
    "helper output and result, 30 seconds. No content or Jev calls.\",",
    schema_piece.p0011(),
    "\"properties\":{\"folder\":{\"type\":\"string\",",
    "\"description\":\"Mailbox name; at most 1024 UTF-8 bytes. Default ",
    "INBOX.\"},\"uids\":{\"type\":\"array\",\"items\":{\"type\":\"integer\",",
    "\"minimum\":1,\"maximum\":4294967295},\"minItems\":1,\"maxItems\":100},",
    schema_piece.p0307(),
    "\"maximum\":4294967295,\"description\":\"Expected mailbox identity from ",
    "earlier reads.\"}},\"required\":[\"uids\",\"uidvalidity\"],",
    schema_piece.p0008(),
    schema_piece.p0009(),
    schema_piece.p0002(),
    schema_piece.p0003(),
    schema_piece.p0032(),
    schema_piece.p0033(),
    "\"reset_required\":{\"type\":\"boolean\"},",
    "\"complete\":{\"type\":\"boolean\"},\"present\":{\"type\":\"array\",",
    schema_piece.p0010(),
    schema_piece.p0347(),
    "\"flags\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},",
    "\"required\":[\"uid\",\"flags\"],\"additionalProperties\":false}},",
    "\"absent\":{\"type\":\"array\",\"items\":{\"type\":\"integer\",",
    "\"minimum\":0}},\"unknown\":{\"type\":\"array\",",
    schema_piece.p0348(),
    "\"reason\":{\"type\":\"string\"}},\"required\":[\"folder\",",
    "\"uidvalidity\",\"reset_required\",\"complete\",\"present\",\"absent\",",
    "\"unknown\",\"reason\"],\"additionalProperties\":false}]},",
    schema_piece.p0294(),
    schema_piece.p0295()])

def tool_defs.mail_get_thread() -> String:
  String.concat([
    "{\"name\":\"mail_get_thread\",\"title\":\"Read a mail thread\",",
    "\"description\":\"Read the conversation a message belongs to, oldest ",
    "first (by INTERNALDATE, then UID): the messages in its folder, INBOX and ",
    "the resolved Sent and Archive folders that are linked to it by ",
    "Message-ID, In-Reply-To and References, each with its folder, ",
    "uidvalidity and parent (the Message-ID of the message it answers in the ",
    "thread, or null). Messages are never grouped by subject. Two rounds of ",
    "linked IDs are searched, at most 50 IDs each, so a long thread can be ",
    "cut short; searched lists the folders. Changes nothing: messages stay ",
    schema_piece.p0118(),
    schema_piece.p0119(),
    schema_piece.p0120(),
    schema_piece.p0121(),
    schema_piece.p0011(),
    schema_piece.p0012(),
    schema_piece.p0122(),
    schema_piece.p0123(),
    schema_piece.p0349(),
    "seed folder returned with its UID. Checked in the seed read session ",
    "before any message fetch; mismatch returns no content and makes no Jev ",
    "request. Later thread sessions pin each folder's own discovered ",
    "UIDVALIDITY. Omit to preserve legacy behavior.\"},",
    schema_piece.p0014(),
    schema_piece.p0015(),
    schema_piece.p0016(),
