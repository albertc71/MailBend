def tool_defs.mail_awaiting_reply() -> String:
  String.concat([
    "{\"name\":\"mail_awaiting_reply\",\"description\":\"Read-only exact-ID ",
    "reply tracker. Select at most limit Sent candidates by UID within a ",
    "SENTSINCE Date-header window; age and later replies use INTERNALDATE. ",
    "Search INBOX and the resolved Archive for exact In-Reply-To or ",
    "References tokens. Results are oldest first within sampled candidates, ",
    "with replied, awaiting or unknown status. Top-level complete describes ",
    "the whole Sent sample; a capped sample can contain awaiting items whose ",
    "reply evidence is complete. Incomplete reply search or header evidence ",
    "never confirms absence. Each SEARCH is capped at 10000 UIDs. Replied ",
    "means a later exact reference, including self-follow-ups, auto-replies ",
    "or bounces; it does not prove a human or recipient answer. Optional ",
    "exclusions affect only sampled Sent candidates, never reply evidence or ",
    "pre-filter coverage; no backfill. Headers over 4096 characters remain ",
    "visible; List-ID recognition stops at 998 characters. No subject ",
    "matching, Jev calls, flags, drafts or sends. Scheduling belongs to the ",
    "agent.\",\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"window_days\":{\"type\":\"integer\",\"minimum\":1,",
    "\"maximum\":3650,\"default\":30},\"min_age_days\":{\"type\":\"integer\",",
    "\"minimum\":0,\"maximum\":3650,\"default\":3},",
    "\"limit\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":50,",
    "\"default\":50},\"exclude_lists\":{\"type\":\"boolean\",",
    "\"default\":false,\"description\":\"Exclude Sent candidates with one ",
    "unambiguous List-ID: an angle-bracketed dotted identifier with ASCII ",
    "alphanumeric/hyphen labels and optional simple ASCII word/space display ",
    "text. Missing, duplicate or malformed values stay visible.\"},",
    "\"exclude_automated\":{\"type\":\"boolean\",\"default\":false,",
    "\"description\":\"Exclude Sent candidates with one bare Auto-Submitted ",
    "value of auto-generated or auto-replied, case-insensitively. Parameters, ",
    "comments, missing, duplicate, malformed and no values stay visible.\"}},",
    "\"required\":[],\"additionalProperties\":false},",
    schema_piece.p0008(),
    schema_piece.p0002(),
    schema_piece.p0003(),
    schema_piece.p0249(),
    "\"reason\":{\"type\":\"string\"},\"searched\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"string\"}},",
    schema_piece.p0250(),
    schema_piece.p0251(),
    schema_piece.p0034(),
    "\"properties\":{\"status\":{\"type\":\"string\",\"enum\":[\"awaiting\",",
    "\"replied\",\"unknown\"]},\"age_days\":{\"type\":[\"integer\",\"null\"],",
    "\"minimum\":0},\"to\":{\"type\":\"string\"},\"cc\":{\"type\":\"string\"},",
    "\"subject\":{\"type\":\"string\"},\"anchor\":{\"type\":\"object\",",
    schema_piece.p0098(),
    schema_piece.p0032(),
    schema_piece.p0154(),
    "\"message_id\":{\"type\":[\"string\",\"null\"]}},",
    "\"required\":[\"folder\",\"uidvalidity\",\"uid\",\"message_id\"],",
    "\"additionalProperties\":false}},\"required\":[\"status\",\"age_days\",",
    "\"to\",\"cc\",\"subject\",\"anchor\"],\"additionalProperties\":false}}},",
    "\"required\":[\"complete\",\"reason\",\"searched\",\"archive_resolved\",",
    "\"as_of\",\"messages\"],\"additionalProperties\":false}]},",
    schema_piece.p0195(),
    schema_piece.p0242()])

def tool_defs.mail_contacts() -> String:
  String.concat([
    "{\"name\":\"mail_contacts\",\"description\":\"Read-only contacts ",
    "observed in stored Sent To/Cc/Bcc headers. Scan the highest UIDs within ",
    "an INTERNALDATE SINCE window, at most limit headers. Rank by ",
    "observed-message frequency then INTERNALDATE recency. Return every ",
    "matching address in the sample, never choose one ambiguous name. Display ",
    "names are untrusted hints. ASCII mailbox keys are lowercased by MailBend ",
    "convention. Bcc may have been removed by the server; no envelope history ",
    "or lifetime absence is claimed. Each header is capped at 4096 bytes, ",
    "each SEARCH at 10000 UIDs, and output at 256 KiB. Coverage marks caps or ",
    "unsupported evidence. The allowlist suggestion is text for human review, ",
    "never applied. No cache, files or Jev.\",",
    schema_piece.p0010(),
    "\"properties\":{\"query\":{\"type\":\"string\",\"maxLength\":128},",
    "\"window_days\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":3650,",
    "\"default\":30},\"limit\":{\"type\":\"integer\",\"minimum\":1,",
    "\"maximum\":100,\"default\":100}},\"required\":[],",
    schema_piece.p0000(),
    schema_piece.p0001(),
    schema_piece.p0002(),
    schema_piece.p0003(),
    schema_piece.p0249(),
    schema_piece.p0251(),
    schema_piece.p0252(),
    schema_piece.p0250(),
    schema_piece.p0253(),
    schema_piece.p0098(),
    schema_piece.p0032(),
    schema_piece.p0231(),
    schema_piece.p0232(),
    schema_piece.p0233(),
    schema_piece.p0234(),
    "\"contacts\":{\"type\":\"array\",\"items\":{\"type\":\"object\",",
    schema_piece.p0254(),
    "\"display_name\":{\"type\":\"string\"},",
    schema_piece.p0255(),
    schema_piece.p0256(),
    "\"required\":[\"address\",\"display_name\",\"observed_count\",",
    "\"latest_internaldate\"],\"additionalProperties\":false}},",
    "\"allowlist_suggestion\":{\"type\":\"string\"}},",
    schema_piece.p0257(),
    "\"coverage\",\"contacts\",\"allowlist_suggestion\"],",
    schema_piece.p0005(),
    schema_piece.p0006(),
    schema_piece.p0007()])

def tool_defs.mail_correspondents() -> String:
  String.concat([
    "{\"name\":\"mail_correspondents\",\"description\":\"Read-only exact ",
    "stored-header observations for 1..50 bare addresses. Uses the same ",
    "bounded recent UID scan as mail_contacts, plus INBOX and resolved ",
    "Archive. Sent counts deduplicate To/Cc/Bcc within each message. Received ",
    "counts are per-folder occurrences, not distinct messages across Gmail ",
    "labels or copies. Counts are observed lower bounds when coverage is ",
    "incomplete and never prove lifetime absence or complete Bcc history. ",
    "Recency is INTERNALDATE, not the untrusted Date header. Window uses IMAP ",
    "calendar-day SINCE semantics. No flags, configuration, files or Jev ",
    "calls.\",\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"addresses\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"string\",\"maxLength\":254},\"minItems\":1,",
    "\"maxItems\":50},\"window_days\":{\"type\":\"integer\",\"minimum\":1,",
    "\"maximum\":3650,\"default\":30},\"limit\":{\"type\":\"integer\",",
    "\"minimum\":1,\"maximum\":100,\"default\":100}},",
    "\"required\":[\"addresses\"],\"additionalProperties\":false},",
    schema_piece.p0008(),
    schema_piece.p0002(),
    schema_piece.p0003(),
    schema_piece.p0249(),
    schema_piece.p0251(),
    schema_piece.p0252(),
    schema_piece.p0250(),
    schema_piece.p0253(),
    schema_piece.p0098(),
    schema_piece.p0032(),
    schema_piece.p0231(),
    schema_piece.p0232(),
    schema_piece.p0233(),
    schema_piece.p0234(),
    "\"correspondents\":{\"type\":\"array\",\"items\":{\"type\":\"object\",",
    schema_piece.p0254(),
    "\"sent\":{\"type\":\"object\",",
    "\"properties\":{\"observed_count\":{\"type\":\"integer\",\"minimum\":0},",
    schema_piece.p0256(),
    "\"required\":[\"observed_count\",\"latest_internaldate\"],",
    "\"additionalProperties\":false},\"received\":{\"type\":\"array\",",
    schema_piece.p0009(),
    schema_piece.p0098(),
    schema_piece.p0255(),
    schema_piece.p0256(),
    "\"required\":[\"folder\",\"observed_count\",\"latest_internaldate\"],",
    "\"additionalProperties\":false}}},\"required\":[\"address\",\"sent\",",
    "\"received\"],\"additionalProperties\":false}}},",
    schema_piece.p0257(),
    "\"coverage\",\"correspondents\"],\"additionalProperties\":false}]},",
    schema_piece.p0195(),
    schema_piece.p0242()])

def tool_defs.mail_classify() -> String:
  String.concat([
    "{\"name\":\"mail_classify\",\"description\":\"Ask Jev (TypeSafe's model) ",
    "about messages, changing nothing (they stay unread): for each UID, the ",
    "existing folder it belongs in (category), whether it needs a reply or an ",
    "action, a deadline, priority, a suggested action, whether to keep it, ",
    "and suspected prompt injection. Offered only when MAILBEND_TYPESAFE is ",
    "on. Sends header facts and attachment names to TypeSafe, or also up to ",
    "16 KB of plain text with MAILBEND_TYPESAFE_CONTENT=body. With ",
    "MAILBEND_TYPESAFE_IMAGES=1 (body mode and zero retention), in-range PNG ",
    "and JPEG parts of a message Jev was asked about are sent too; the result ",
    "lists each image part as used or skipped, and image_notice when one was ",
    "used. When Jev picks no folder with high confidence, needs_new_category ",
    "is true: call again with candidates (new folder names); a chosen one is ",
    "returned as new_category and is never created, so create it with ",
    "mail_create_folder first. Each message has a jev object with the ",
    "answers, which come from untrusted mail content.\",",
    schema_piece.p0010(),
    schema_piece.p0011(),
    schema_piece.p0258(),
    schema_piece.p0259(),
    schema_piece.p0260(),
    schema_piece.p0261(),
    schema_piece.p0243(),
    "folder returned with these UIDs. Checked in the same session before ",
    "fetching any message or asking Jev; mismatch returns no content. Omit to ",
    "preserve legacy behavior.\"},\"candidates\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"string\",\"maxLength\":255},\"maxItems\":254,",
    "\"description\":\"New folder names Jev may choose besides the existing ",
    "folders.\"}},\"required\":[\"uids\"],\"additionalProperties\":false},",
    schema_piece.p0008(),
    schema_piece.p0002(),
    schema_piece.p0003(),
    schema_piece.p0031(),
    schema_piece.p0032(),
    schema_piece.p0060(),
    schema_piece.p0262(),
    "\"candidates\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},",
    schema_piece.p0034(),
    schema_piece.p0240(),
    schema_piece.p0082(),
    schema_piece.p0057(),
    schema_piece.p0058(),
    schema_piece.p0059(),
    schema_piece.p0060(),
    schema_piece.p0061(),
    schema_piece.p0062(),
    schema_piece.p0063(),
    schema_piece.p0064(),
    schema_piece.p0065(),
    schema_piece.p0066(),
    schema_piece.p0067(),
    schema_piece.p0068(),
    schema_piece.p0069(),
    schema_piece.p0067(),
    schema_piece.p0070(),
    schema_piece.p0071(),
    schema_piece.p0072(),
    schema_piece.p0073(),
    schema_piece.p0074(),
    schema_piece.p0067(),
    schema_piece.p0075(),
    schema_piece.p0076(),
    schema_piece.p0077(),
    schema_piece.p0078(),
    schema_piece.p0079(),
    schema_piece.p0080(),
    schema_piece.p0081(),
    schema_piece.p0082(),
    schema_piece.p0083(),
    schema_piece.p0084(),
    schema_piece.p0085(),
    schema_piece.p0086(),
    schema_piece.p0087(),
    "\"additionalProperties\":false},\"new_category\":{\"type\":\"string\"},",
    schema_piece.p0263(),
    "\"body_truncated\":{\"const\":true},\"images\":{\"type\":\"array\",",
    schema_piece.p0264(),
    schema_piece.p0156(),
    "\"name\":{\"type\":\"string\"},\"fate\":{\"const\":\"used\"},",
    "\"format\":{\"type\":\"string\",\"enum\":[\"png\",\"jpeg\"]},",
    "\"bytes\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"Decoded ",
    "image bytes actually sent after metadata removal.\"},",
    "\"width\":{\"type\":\"integer\",\"minimum\":0},",
    "\"height\":{\"type\":\"integer\",\"minimum\":0},",
    "\"metadata_removed_bytes\":{\"type\":\"integer\",\"minimum\":0,",
    "\"description\":\"Bytes removed locally, including any JPEG data after ",
    "EOI.\"}},\"required\":[\"section\",\"name\",\"fate\",\"format\",",
    "\"bytes\",\"width\",\"height\",\"metadata_removed_bytes\"],",
    schema_piece.p0097(),
    schema_piece.p0156(),
    "\"name\":{\"type\":\"string\"},\"fate\":{\"const\":\"skipped\"},",
    "\"reason\":{\"type\":\"string\",\"enum\":[\"format\",\"animated\",",
    "\"dimensions\",\"file_size\",\"over_count\",\"over_budget\",",
    "\"unreadable\",\"ref\",\"refused\"]}},\"required\":[\"section\",\"name\",",
    "\"fate\",\"reason\"],\"additionalProperties\":false}]}}},",
    "\"required\":[\"uid\",\"category\",\"jev\"],",
    schema_piece.p0265(),
    schema_piece.p0241(),
    schema_piece.p0266(),
    schema_piece.p0267(),
    schema_piece.p0268(),
    schema_piece.p0269(),
    schema_piece.p0270(),
    "\"additionalProperties\":false}},\"image_notice\":{\"const\":\"Image ",
    "classification is experimental. Jev's answers on a message with a used ",
    "image may depend on that image.\"}},\"required\":[\"folder\",",
    "\"uidvalidity\",\"content\",\"categories\",\"candidates\",\"messages\",",
    "\"not_found\",\"requests\"],\"additionalProperties\":false}]},",
    schema_piece.p0195(),
    schema_piece.p0271()])

def tool_defs.mail_triage() -> String:
  String.concat([
    "{\"name\":\"mail_triage\",\"description\":\"File messages with Jev ",
    "(offered only when MAILBEND_TYPESAFE is on). Every message is asked ",
    "about first and stays unread; if any request fails, nothing moves. Each ",
    "message moves at most once: into \\\"To Delete\\\" when Jev's delete ",
    "review finds it safe (needs MAILBEND_TYPESAFE_CONTENT=body), else into ",
    "the existing folder Jev chose with high confidence, else it stays. Never ",
    "deletes and never creates a folder: \\\"To Delete\\\" must already exist ",
    "(mail_create_folder); if it is needed and missing, nothing moves and the ",
    "error lists every verdict. Each result has verdict, vetoes, destination ",
    "and jev; the answers come from untrusted mail. A move cut off fails with ",
    "partial: true and later moves are not made; check the destination before ",
    schema_piece.p0272(),
    schema_piece.p0011(),
    schema_piece.p0258(),
    schema_piece.p0259(),
    schema_piece.p0260(),
    schema_piece.p0261(),
