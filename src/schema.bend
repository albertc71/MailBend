def tool_defs.mail_search() -> String:
  String.concat([
    "{\"name\":\"mail_search\",\"title\":\"Search mail\",",
    "\"description\":\"Search a folder, newest first. Opens the folder ",
    "read-only, so nothing is marked read. All criteria are combined with ",
    "AND. Pass next_cursor back as cursor with the same folder and criteria ",
    "for older matches. has_more=false and next_cursor=null end traversal. ",
    "Searches are re-evaluated; new arrivals above the boundary are excluded. ",
    "UID SEARCH still enumerates matches. With MAILBEND_TYPESAFE on, each ",
    "message also has a jev object with Jev's notes (reply_needed, ",
    "action_required, priority, category, suggested_action, and ",
    "suspected_injection when suspected), drawn from untrusted mail content; ",
    "its status is unchecked when TypeSafe failed.\",",
    schema_piece.p0011(),
    schema_piece.p0012(),
    "(IMAP mailbox) name. Default: INBOX.\"},\"from\":{\"type\":\"string\"},",
    schema_piece.p0013(),
    "\"subject\":{\"type\":\"string\"},\"body\":{\"type\":\"string\",",
    "\"description\":\"Text in the body.\"},\"text\":{\"type\":\"string\",",
    "\"description\":\"Text anywhere in headers or body.\"},",
    "\"since\":{\"type\":\"string\",\"description\":\"On or after this date, ",
    "YYYY-MM-DD.\"},\"before\":{\"type\":\"string\",\"description\":\"Before ",
    "this date, YYYY-MM-DD.\"},\"unseen\":{\"type\":\"boolean\",",
    "\"description\":\"True selects unread; false selects read. Omit for ",
    "either. If seen is also given, the values must be opposite.\"},",
    "\"seen\":{\"type\":\"boolean\",\"description\":\"True selects read; ",
    "false selects unread. Omit for either. If unseen is also given, the ",
    "values must be opposite.\"},\"flagged\":{\"type\":\"boolean\",",
    "\"description\":\"True selects flagged; false selects unflagged. Omit ",
    "for either.\"},\"answered\":{\"type\":\"boolean\",\"description\":\"True ",
    "selects the IMAP \\\\Answered flag; false selects its absence. Omit for ",
    "either. This does not infer replies or resolved conversations.\"},",
    "\"draft\":{\"type\":\"boolean\",\"description\":\"True selects the IMAP ",
    "\\\\Draft flag; false selects its absence. Omit for either. Searches the ",
    "selected folder, not automatically Drafts.\"},",
    "\"cursor\":{\"type\":\"string\",\"maxLength\":4096,",
    "\"description\":\"Opaque continuation from next_cursor; at most 4096 ",
    "characters.\"},\"limit\":{\"type\":\"integer\",\"minimum\":1,",
    "\"maximum\":200,\"description\":\"Default 20.\"},",
