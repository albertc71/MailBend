def tool_defs.mail_get_attachment() -> String:
  String.concat([
    "{\"name\":\"mail_get_attachment\",\"description\":\"Save one attachment ",
    "of a message as a new file in MAILBEND_DOWNLOAD_DIR (downloads are off ",
    "without it) and return its path. The message is read as mail_get reads ",
    "it, so it stays unread. With section and uidvalidity only that part is ",
    "read (under 25 MB encoded); otherwise the complete message must fit 25 ",
    "MB. The file name is the attachment's (or filename) without any ",
    "directory, control or invisible format characters or leading dots. An ",
    "existing file is never replaced: the call fails, so pass another ",
    "filename. Not available in read-only mode.\",",
    "\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"folder\":{\"type\":\"string\",\"description\":\"Folder ",
    "(IMAP mailbox) name. Default: INBOX.\"},\"uid\":{\"type\":\"integer\",",
    "\"minimum\":1},\"uidvalidity\":{\"type\":\"integer\",\"minimum\":1,",
    "\"maximum\":4294967295,\"description\":\"The folder's UIDVALIDITY ",
    "returned with the UIDs (mail_search, mail_get, mail_get_new). If ",
    "supplied, checked in the same session before fetching message content; a ",
    "mismatch returns no content and, for downloads, saves no file. Pass the ",
    "folder the UIDs came from. Required for selected-part reads.\"},",
    "\"section\":{\"type\":\"string\",\"description\":\"Numeric section from ",
    "mail_get(section=list). Requires uidvalidity; replaces index. Only ",
    "complete decoded files are saved.\"},\"index\":{\"type\":\"integer\",",
    "\"minimum\":0,\"description\":\"The attachment's position in mail_get's ",
    "attachments, from 0.\"},\"filename\":{\"type\":\"string\",",
    "\"description\":\"Name to save the file as. Default: the attachment's ",
    "file name.\"},\"dry_run\":{\"type\":\"boolean\",\"description\":\"Only ",
    "show what this call would do: return the IMAP commands, the SMTP sender ",
    "and recipients with sent_copy (whether MAILBEND_SAVE_SENT would save a ",
    "Sent copy), or the file it would use, with message and file contents as ",
    "<N bytes>. Nothing is changed, sent or saved. It is not a full ",
    "pre-check: marking and flagging make no connection, so a stale ",
    "uidvalidity fails only the real call, and a send does not check the ",
    "daily limit. With MAILBEND_TYPESAFE on, a send or delete still passes ",
    "Jev's checks and shows their verdict. Default false.\"}},",
    "\"required\":[\"uid\"],\"additionalProperties\":false},",
    "\"outputSchema\":{\"type\":\"object\",\"anyOf\":[{\"type\":\"object\",",
    "\"properties\":{\"error\":{\"type\":\"string\"}},",
    "\"required\":[\"error\"],\"additionalProperties\":false},",
    "{\"type\":\"object\",\"properties\":{\"folder\":{\"type\":\"string\"},",
    "\"uid\":{\"type\":\"integer\",\"minimum\":0},",
    "\"filename\":{\"type\":\"string\"},",
    "\"content_type\":{\"type\":\"string\"},\"size\":{\"type\":\"integer\",",
    "\"minimum\":0},\"path\":{\"type\":\"string\"}},\"required\":[\"folder\",",
    "\"uid\",\"filename\",\"content_type\",\"size\",\"path\"],",
    "\"additionalProperties\":false},{\"type\":\"object\",",
    "\"properties\":{\"dry_run\":{\"const\":true},",
    "\"file\":{\"type\":\"object\",",
    "\"properties\":{\"path\":{\"type\":\"string\"},",
    "\"data\":{\"type\":\"string\"}},\"required\":[\"path\",\"data\"],",
    "\"additionalProperties\":false}},\"required\":[\"dry_run\",\"file\"],",
    "\"additionalProperties\":false}]},",
    "\"annotations\":{\"readOnlyHint\":false,\"destructiveHint\":false,",
    "\"idempotentHint\":false,\"openWorldHint\":false}}"])

def tool_defs.mail_mark_read() -> String:
  String.concat([
    "{\"name\":\"mail_mark_read\",\"description\":\"Mark messages as read ",
    "(add the \\\\Seen flag).\",\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"folder\":{\"type\":\"string\",\"description\":\"Folder ",
    "(IMAP mailbox) name. Default: INBOX.\"},\"uids\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":1},\"minItems\":1,",
    "\"description\":\"Message UIDs in the folder (from mail_search or ",
    "mail_get_new).\"},\"uidvalidity\":{\"type\":\"integer\",\"minimum\":1,",
    "\"description\":\"The folder's UIDVALIDITY returned with the UIDs ",
    "(mail_search, mail_get, mail_get_new). Checked in the same session as ",
    "the change; if the folder changed since, nothing is changed.\"},",
    "\"dry_run\":{\"type\":\"boolean\",\"description\":\"Only show what this ",
    "call would do: return the IMAP commands, the SMTP sender and recipients ",
    "with sent_copy (whether MAILBEND_SAVE_SENT would save a Sent copy), or ",
    "the file it would use, with message and file contents as <N bytes>. ",
    "Nothing is changed, sent or saved. It is not a full pre-check: marking ",
    "and flagging make no connection, so a stale uidvalidity fails only the ",
    "real call, and a send does not check the daily limit. With ",
    "MAILBEND_TYPESAFE on, a send or delete still passes Jev's checks and ",
    "shows their verdict. Default false.\"}},\"required\":[\"uids\",",
    "\"uidvalidity\"],\"additionalProperties\":false},",
    "\"outputSchema\":{\"type\":\"object\",\"anyOf\":[{\"type\":\"object\",",
    "\"properties\":{\"error\":{\"type\":\"string\"}},",
    "\"required\":[\"error\"],\"additionalProperties\":false},",
    "{\"type\":\"object\",\"properties\":{\"ok\":{\"const\":true},",
    "\"folder\":{\"type\":\"string\"},\"changed\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":0}},",
    "\"missing\":{\"type\":\"array\",\"items\":{\"type\":\"integer\",",
    "\"minimum\":0}},\"seen\":{\"const\":true}},\"required\":[\"ok\",",
    "\"folder\",\"changed\",\"missing\",\"seen\"],",
    "\"additionalProperties\":false},{\"type\":\"object\",",
    "\"properties\":{\"dry_run\":{\"const\":true},",
    "\"imap\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},",
    "\"required\":[\"dry_run\",\"imap\"],\"additionalProperties\":false}]},",
    "\"annotations\":{\"readOnlyHint\":false,\"destructiveHint\":false,",
    "\"idempotentHint\":true,\"openWorldHint\":false}}"])

def tool_defs.mail_mark_unread() -> String:
  String.concat([
    "{\"name\":\"mail_mark_unread\",\"description\":\"Mark messages as unread ",
    "(remove the \\\\Seen flag).\",\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"folder\":{\"type\":\"string\",\"description\":\"Folder ",
    "(IMAP mailbox) name. Default: INBOX.\"},\"uids\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":1},\"minItems\":1,",
    "\"description\":\"Message UIDs in the folder (from mail_search or ",
    "mail_get_new).\"},\"uidvalidity\":{\"type\":\"integer\",\"minimum\":1,",
    "\"description\":\"The folder's UIDVALIDITY returned with the UIDs ",
    "(mail_search, mail_get, mail_get_new). Checked in the same session as ",
    "the change; if the folder changed since, nothing is changed.\"},",
    "\"dry_run\":{\"type\":\"boolean\",\"description\":\"Only show what this ",
    "call would do: return the IMAP commands, the SMTP sender and recipients ",
    "with sent_copy (whether MAILBEND_SAVE_SENT would save a Sent copy), or ",
    "the file it would use, with message and file contents as <N bytes>. ",
    "Nothing is changed, sent or saved. It is not a full pre-check: marking ",
    "and flagging make no connection, so a stale uidvalidity fails only the ",
    "real call, and a send does not check the daily limit. With ",
    "MAILBEND_TYPESAFE on, a send or delete still passes Jev's checks and ",
    "shows their verdict. Default false.\"}},\"required\":[\"uids\",",
    "\"uidvalidity\"],\"additionalProperties\":false},",
    "\"outputSchema\":{\"type\":\"object\",\"anyOf\":[{\"type\":\"object\",",
    "\"properties\":{\"error\":{\"type\":\"string\"}},",
    "\"required\":[\"error\"],\"additionalProperties\":false},",
    "{\"type\":\"object\",\"properties\":{\"ok\":{\"const\":true},",
    "\"folder\":{\"type\":\"string\"},\"changed\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":0}},",
    "\"missing\":{\"type\":\"array\",\"items\":{\"type\":\"integer\",",
    "\"minimum\":0}},\"seen\":{\"const\":false}},\"required\":[\"ok\",",
    "\"folder\",\"changed\",\"missing\",\"seen\"],",
    "\"additionalProperties\":false},{\"type\":\"object\",",
    "\"properties\":{\"dry_run\":{\"const\":true},",
    "\"imap\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},",
    "\"required\":[\"dry_run\",\"imap\"],\"additionalProperties\":false}]},",
    "\"annotations\":{\"readOnlyHint\":false,\"destructiveHint\":false,",
    "\"idempotentHint\":true,\"openWorldHint\":false}}"])

def tool_defs.mail_flag() -> String:
  String.concat([
    "{\"name\":\"mail_flag\",\"description\":\"Flag messages (add ",
    "\\\\Flagged). With a colour, also set exactly that Apple Mail colour's ",
    "$MailFlagBit0-2 keywords and clear the others (red has none); without ",
    "one, the current colour is kept. With a colour the result has ",
    "colour_kept: true; false when a message shows other flags or ",
    "PERMANENTFLAGS says a change lasts only for this session ",
    "(colour_not_kept lists those UIDs); or \\\"unverified\\\" when the ",
    "server sent no PERMANENTFLAGS or no flags for a message. flags lists ",
    "each changed UID's flags as the server reported them after the change ",
    "(null if it reported none). If the change stops once a store was ",
    "acknowledged or sent unanswered (or the TLS helper is lost after ",
    "starting), the call fails with partial: true, listing the acknowledged ",
    "changes and those that may have run unanswered; a retry is idempotent ",
    "but may fail again on a server that refuses the colour keywords. A ",
    "change that stopped before any store could run, or whose UIDs none ",
    "exist, is a plain error.\",\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"folder\":{\"type\":\"string\",\"description\":\"Folder ",
    "(IMAP mailbox) name. Default: INBOX.\"},\"uids\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":1},\"minItems\":1,",
    "\"description\":\"Message UIDs in the folder (from mail_search or ",
    "mail_get_new).\"},\"uidvalidity\":{\"type\":\"integer\",\"minimum\":1,",
    "\"description\":\"The folder's UIDVALIDITY returned with the UIDs ",
    "(mail_search, mail_get, mail_get_new). Checked in the same session as ",
    "the change; if the folder changed since, nothing is changed.\"},",
    "\"colour\":{\"type\":\"string\",\"enum\":[\"red\",\"orange\",\"yellow\",",
    "\"green\",\"blue\",\"purple\",\"grey\"],\"description\":\"Flag colour. ",
    "Omit it to keep the current colour.\"},\"dry_run\":{\"type\":\"boolean\",",
    "\"description\":\"Only show what this call would do: return the IMAP ",
    "commands, the SMTP sender and recipients with sent_copy (whether ",
    "MAILBEND_SAVE_SENT would save a Sent copy), or the file it would use, ",
    "with message and file contents as <N bytes>. Nothing is changed, sent or ",
    "saved. It is not a full pre-check: marking and flagging make no ",
    "connection, so a stale uidvalidity fails only the real call, and a send ",
    "does not check the daily limit. With MAILBEND_TYPESAFE on, a send or ",
    "delete still passes Jev's checks and shows their verdict. Default ",
    "false.\"}},\"required\":[\"uids\",\"uidvalidity\"],",
    "\"additionalProperties\":false},\"outputSchema\":{\"type\":\"object\",",
    "\"anyOf\":[{\"type\":\"object\",",
    "\"properties\":{\"error\":{\"type\":\"string\"}},",
    "\"required\":[\"error\"],\"additionalProperties\":false},",
    "{\"type\":\"object\",\"properties\":{\"ok\":{\"const\":false},",
    "\"partial\":{\"const\":true},\"folder\":{\"type\":\"string\"},",
    "\"acknowledged\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},",
    "\"unconfirmed\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},",
    "\"message\":{\"type\":\"string\"}},\"required\":[\"ok\",\"partial\",",
    "\"folder\",\"acknowledged\",\"unconfirmed\",\"message\"],",
    "\"additionalProperties\":false},{\"type\":\"object\",",
    "\"properties\":{\"ok\":{\"const\":true},\"folder\":{\"type\":\"string\"},",
    "\"changed\":{\"type\":\"array\",\"items\":{\"type\":\"integer\",",
    "\"minimum\":0}},\"missing\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":0}},",
    "\"flagged\":{\"const\":true},\"flags\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"object\",",
    "\"properties\":{\"uid\":{\"type\":\"integer\",\"minimum\":0},",
    "\"flags\":{\"type\":[\"array\",\"null\"],",
    "\"items\":{\"type\":\"string\"}}},\"required\":[\"uid\",\"flags\"],",
    "\"additionalProperties\":false}},\"colour\":{\"type\":\"string\"},",
    "\"colour_kept\":{\"anyOf\":[{\"type\":\"boolean\"},",
    "{\"const\":\"unverified\"}]},\"colour_not_kept\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":0}}},\"required\":[\"ok\",",
    "\"folder\",\"changed\",\"missing\",\"flagged\",\"flags\"],",
    "\"additionalProperties\":false},{\"type\":\"object\",",
    "\"properties\":{\"dry_run\":{\"const\":true},",
    "\"imap\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},",
    "\"required\":[\"dry_run\",\"imap\"],\"additionalProperties\":false}]},",
    "\"annotations\":{\"readOnlyHint\":false,\"destructiveHint\":false,",
    "\"idempotentHint\":true,\"openWorldHint\":false}}"])

def tool_defs.mail_unflag() -> String:
  String.concat([
    "{\"name\":\"mail_unflag\",\"description\":\"Unflag messages: remove ",
    "\\\\Flagged, then clear every colour keyword. flags lists each changed ",
    "UID's flags as the server reported them after the change (null if it ",
    "reported none). If the change stops once a store was acknowledged or ",
    "sent unanswered (or the TLS helper is lost after starting), the call ",
    "fails with partial: true, listing the acknowledged changes and those ",
    "that may have run unanswered; a retry is idempotent but may fail again ",
    "on a server that refuses the colour keywords. A change that stopped ",
    "before any store could run, or whose UIDs none exist, is a plain ",
    "error.\",\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"folder\":{\"type\":\"string\",\"description\":\"Folder ",
    "(IMAP mailbox) name. Default: INBOX.\"},\"uids\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":1},\"minItems\":1,",
    "\"description\":\"Message UIDs in the folder (from mail_search or ",
    "mail_get_new).\"},\"uidvalidity\":{\"type\":\"integer\",\"minimum\":1,",
    "\"description\":\"The folder's UIDVALIDITY returned with the UIDs ",
    "(mail_search, mail_get, mail_get_new). Checked in the same session as ",
    "the change; if the folder changed since, nothing is changed.\"},",
    "\"dry_run\":{\"type\":\"boolean\",\"description\":\"Only show what this ",
    "call would do: return the IMAP commands, the SMTP sender and recipients ",
    "with sent_copy (whether MAILBEND_SAVE_SENT would save a Sent copy), or ",
    "the file it would use, with message and file contents as <N bytes>. ",
    "Nothing is changed, sent or saved. It is not a full pre-check: marking ",
    "and flagging make no connection, so a stale uidvalidity fails only the ",
    "real call, and a send does not check the daily limit. With ",
    "MAILBEND_TYPESAFE on, a send or delete still passes Jev's checks and ",
    "shows their verdict. Default false.\"}},\"required\":[\"uids\",",
    "\"uidvalidity\"],\"additionalProperties\":false},",
    "\"outputSchema\":{\"type\":\"object\",\"anyOf\":[{\"type\":\"object\",",
    "\"properties\":{\"error\":{\"type\":\"string\"}},",
    "\"required\":[\"error\"],\"additionalProperties\":false},",
    "{\"type\":\"object\",\"properties\":{\"ok\":{\"const\":false},",
    "\"partial\":{\"const\":true},\"folder\":{\"type\":\"string\"},",
    "\"acknowledged\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},",
    "\"unconfirmed\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},",
    "\"message\":{\"type\":\"string\"}},\"required\":[\"ok\",\"partial\",",
    "\"folder\",\"acknowledged\",\"unconfirmed\",\"message\"],",
    "\"additionalProperties\":false},{\"type\":\"object\",",
    "\"properties\":{\"ok\":{\"const\":true},\"folder\":{\"type\":\"string\"},",
    "\"changed\":{\"type\":\"array\",\"items\":{\"type\":\"integer\",",
    "\"minimum\":0}},\"missing\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":0}},",
    "\"flagged\":{\"const\":false},\"flags\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"object\",",
    "\"properties\":{\"uid\":{\"type\":\"integer\",\"minimum\":0},",
    "\"flags\":{\"type\":[\"array\",\"null\"],",
    "\"items\":{\"type\":\"string\"}}},\"required\":[\"uid\",\"flags\"],",
    "\"additionalProperties\":false}}},\"required\":[\"ok\",\"folder\",",
    "\"changed\",\"missing\",\"flagged\",\"flags\"],",
    "\"additionalProperties\":false},{\"type\":\"object\",",
    "\"properties\":{\"dry_run\":{\"const\":true},",
    "\"imap\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},",
    "\"required\":[\"dry_run\",\"imap\"],\"additionalProperties\":false}]},",
    "\"annotations\":{\"readOnlyHint\":false,\"destructiveHint\":false,",
    "\"idempotentHint\":true,\"openWorldHint\":false}}"])

def tool_defs.mail_move() -> String:
  String.concat([
    "{\"name\":\"mail_move\",\"description\":\"Move messages to another IMAP ",
    "folder. Uses UID MOVE, or copy + expunge of exactly these UIDs with ",
    "UIDPLUS. It can take mail out of \\\"To Delete\\\", but only mail_triage ",
    "moves mail into it. If the move is cut off after the copy may have run, ",
    "the call fails with partial: true and the messages may be in both ",
    "folders, so check the destination before retrying.\",",
    "\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"folder\":{\"type\":\"string\",\"description\":\"Folder ",
    "(IMAP mailbox) name. Default: INBOX.\"},\"uids\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":1},\"minItems\":1,",
    "\"description\":\"Message UIDs in the folder (from mail_search or ",
    "mail_get_new).\"},\"destination\":{\"type\":\"string\",",
    "\"description\":\"Target folder name.\"},",
    "\"uidvalidity\":{\"type\":\"integer\",\"minimum\":1,",
    "\"description\":\"The folder's UIDVALIDITY returned with the UIDs ",
    "(mail_search, mail_get, mail_get_new). Checked in the same session as ",
    "the change; if the folder changed since, nothing is changed.\"},",
    "\"dry_run\":{\"type\":\"boolean\",\"description\":\"Only show what this ",
    "call would do: return the IMAP commands, the SMTP sender and recipients ",
    "with sent_copy (whether MAILBEND_SAVE_SENT would save a Sent copy), or ",
    "the file it would use, with message and file contents as <N bytes>. ",
    "Nothing is changed, sent or saved. It is not a full pre-check: marking ",
    "and flagging make no connection, so a stale uidvalidity fails only the ",
    "real call, and a send does not check the daily limit. With ",
    "MAILBEND_TYPESAFE on, a send or delete still passes Jev's checks and ",
    "shows their verdict. Default false.\"}},\"required\":[\"uids\",",
    "\"destination\",\"uidvalidity\"],\"additionalProperties\":false},",
    "\"outputSchema\":{\"type\":\"object\",\"anyOf\":[{\"type\":\"object\",",
    "\"properties\":{\"error\":{\"type\":\"string\"}},",
    "\"required\":[\"error\"],\"additionalProperties\":false},",
    "{\"type\":\"object\",\"properties\":{\"ok\":{\"const\":true},",
    "\"folder\":{\"type\":\"string\"},\"changed\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":0}},",
    "\"missing\":{\"type\":\"array\",\"items\":{\"type\":\"integer\",",
    "\"minimum\":0}},\"destination\":{\"type\":\"string\"},",
    "\"method\":{\"type\":\"string\",\"enum\":[\"UID MOVE\",\"UID COPY + UID ",
    "EXPUNGE\"]}},\"required\":[\"ok\",\"folder\",\"changed\",\"missing\",",
    "\"destination\",\"method\"],\"additionalProperties\":false},",
    "{\"type\":\"object\",\"properties\":{\"folder\":{\"type\":\"string\"},",
    "\"destination\":{\"type\":\"string\"},\"method\":{\"type\":\"string\",",
    "\"enum\":[\"UID MOVE\",\"UID COPY + UID EXPUNGE\"]},",
    "\"ok\":{\"const\":false},\"partial\":{\"const\":true},",
    "\"message\":{\"type\":\"string\"}},\"required\":[\"folder\",",
    "\"destination\",\"method\",\"ok\",\"partial\",\"message\"],",
    "\"additionalProperties\":false},{\"type\":\"object\",",
    "\"properties\":{\"dry_run\":{\"const\":true},",
    "\"imap\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},",
    "\"required\":[\"dry_run\",\"imap\"],\"additionalProperties\":false}]},",
    "\"annotations\":{\"readOnlyHint\":false,\"destructiveHint\":false,",
    "\"idempotentHint\":false,\"openWorldHint\":false}}"])

def tool_defs.mail_label() -> String:
  String.concat([
    "{\"name\":\"mail_label\",\"description\":\"Label messages: move them ",
    "into an existing label folder (create one with mail_create_folder). On ",
    "iCloud a label is a folder, so a message has one label and exists once; ",
    "mail_move back to INBOX removes it. Refuses INBOX, Drafts, Sent, Trash, ",
    "Junk, Archive and the other role folders. If the move is cut off after ",
    "the copy may have run, the call fails with partial: true and the ",
    "messages may be in both folders, so check the destination before ",
    "retrying.\",\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"folder\":{\"type\":\"string\",\"description\":\"Folder ",
    "(IMAP mailbox) name. Default: INBOX.\"},\"uids\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":1},\"minItems\":1,",
    "\"description\":\"Message UIDs in the folder (from mail_search or ",
    "mail_get_new).\"},\"label\":{\"type\":\"string\",\"description\":\"Name ",
    "of an existing folder to use as the label.\"},",
    "\"uidvalidity\":{\"type\":\"integer\",\"minimum\":1,",
    "\"description\":\"The folder's UIDVALIDITY returned with the UIDs ",
    "(mail_search, mail_get, mail_get_new). Checked in the same session as ",
    "the change; if the folder changed since, nothing is changed.\"},",
    "\"dry_run\":{\"type\":\"boolean\",\"description\":\"Only show what this ",
    "call would do: return the IMAP commands, the SMTP sender and recipients ",
    "with sent_copy (whether MAILBEND_SAVE_SENT would save a Sent copy), or ",
    "the file it would use, with message and file contents as <N bytes>. ",
    "Nothing is changed, sent or saved. It is not a full pre-check: marking ",
    "and flagging make no connection, so a stale uidvalidity fails only the ",
    "real call, and a send does not check the daily limit. With ",
    "MAILBEND_TYPESAFE on, a send or delete still passes Jev's checks and ",
    "shows their verdict. Default false.\"}},\"required\":[\"uids\",\"label\",",
    "\"uidvalidity\"],\"additionalProperties\":false},",
    "\"outputSchema\":{\"type\":\"object\",\"anyOf\":[{\"type\":\"object\",",
    "\"properties\":{\"error\":{\"type\":\"string\"}},",
    "\"required\":[\"error\"],\"additionalProperties\":false},",
    "{\"type\":\"object\",\"properties\":{\"ok\":{\"const\":true},",
    "\"folder\":{\"type\":\"string\"},\"changed\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":0}},",
    "\"missing\":{\"type\":\"array\",\"items\":{\"type\":\"integer\",",
    "\"minimum\":0}},\"destination\":{\"type\":\"string\"},",
    "\"method\":{\"type\":\"string\",\"enum\":[\"UID MOVE\",\"UID COPY + UID ",
    "EXPUNGE\"]}},\"required\":[\"ok\",\"folder\",\"changed\",\"missing\",",
    "\"destination\",\"method\"],\"additionalProperties\":false},",
    "{\"type\":\"object\",\"properties\":{\"folder\":{\"type\":\"string\"},",
    "\"destination\":{\"type\":\"string\"},\"method\":{\"type\":\"string\",",
    "\"enum\":[\"UID MOVE\",\"UID COPY + UID EXPUNGE\"]},",
    "\"ok\":{\"const\":false},\"partial\":{\"const\":true},",
    "\"message\":{\"type\":\"string\"}},\"required\":[\"folder\",",
    "\"destination\",\"method\",\"ok\",\"partial\",\"message\"],",
    "\"additionalProperties\":false},{\"type\":\"object\",",
    "\"properties\":{\"dry_run\":{\"const\":true},",
    "\"imap\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},",
    "\"required\":[\"dry_run\",\"imap\"],\"additionalProperties\":false}]},",
    "\"annotations\":{\"readOnlyHint\":false,\"destructiveHint\":false,",
    "\"idempotentHint\":false,\"openWorldHint\":false}}"])

def tool_defs.mail_trash() -> String:
  String.concat([
    "{\"name\":\"mail_trash\",\"description\":\"Move messages to the resolved ",
    "trash folder (configured override, advertised special use, or unique ",
    "conventional name). Recoverable; does not delete permanently. Refused ",
    "for mail in \\\"To Delete\\\" (use mail_move or mail_delete there). If ",
    "the move is cut off after the copy may have run, the call fails with ",
    "partial: true and the messages may be in both folders, so check the ",
    "destination before retrying.\",\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"folder\":{\"type\":\"string\",\"description\":\"Folder ",
    "(IMAP mailbox) name. Default: INBOX.\"},\"uids\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":1},\"minItems\":1,",
    "\"description\":\"Message UIDs in the folder (from mail_search or ",
    "mail_get_new).\"},\"uidvalidity\":{\"type\":\"integer\",\"minimum\":1,",
    "\"description\":\"The folder's UIDVALIDITY returned with the UIDs ",
    "(mail_search, mail_get, mail_get_new). Checked in the same session as ",
    "the change; if the folder changed since, nothing is changed.\"},",
    "\"dry_run\":{\"type\":\"boolean\",\"description\":\"Only show what this ",
    "call would do: return the IMAP commands, the SMTP sender and recipients ",
    "with sent_copy (whether MAILBEND_SAVE_SENT would save a Sent copy), or ",
    "the file it would use, with message and file contents as <N bytes>. ",
    "Nothing is changed, sent or saved. It is not a full pre-check: marking ",
    "and flagging make no connection, so a stale uidvalidity fails only the ",
    "real call, and a send does not check the daily limit. With ",
    "MAILBEND_TYPESAFE on, a send or delete still passes Jev's checks and ",
    "shows their verdict. Default false.\"}},\"required\":[\"uids\",",
    "\"uidvalidity\"],\"additionalProperties\":false},",
    "\"outputSchema\":{\"type\":\"object\",\"anyOf\":[{\"type\":\"object\",",
    "\"properties\":{\"error\":{\"type\":\"string\"}},",
    "\"required\":[\"error\"],\"additionalProperties\":false},",
    "{\"type\":\"object\",\"properties\":{\"ok\":{\"const\":true},",
    "\"folder\":{\"type\":\"string\"},\"changed\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":0}},",
    "\"missing\":{\"type\":\"array\",\"items\":{\"type\":\"integer\",",
    "\"minimum\":0}},\"destination\":{\"type\":\"string\"},",
    "\"method\":{\"type\":\"string\",\"enum\":[\"UID MOVE\",\"UID COPY + UID ",
    "EXPUNGE\"]}},\"required\":[\"ok\",\"folder\",\"changed\",\"missing\",",
    "\"destination\",\"method\"],\"additionalProperties\":false},",
    "{\"type\":\"object\",\"properties\":{\"folder\":{\"type\":\"string\"},",
    "\"destination\":{\"type\":\"string\"},\"method\":{\"type\":\"string\",",
    "\"enum\":[\"UID MOVE\",\"UID COPY + UID EXPUNGE\"]},",
    "\"ok\":{\"const\":false},\"partial\":{\"const\":true},",
    "\"message\":{\"type\":\"string\"}},\"required\":[\"folder\",",
    "\"destination\",\"method\",\"ok\",\"partial\",\"message\"],",
    "\"additionalProperties\":false},{\"type\":\"object\",",
    "\"properties\":{\"dry_run\":{\"const\":true},",
    "\"imap\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},",
    "\"required\":[\"dry_run\",\"imap\"],\"additionalProperties\":false}]},",
    "\"annotations\":{\"readOnlyHint\":false,\"destructiveHint\":false,",
    "\"idempotentHint\":false,\"openWorldHint\":false}}"])

def tool_defs.mail_delete() -> String:
  String.concat([
    "{\"name\":\"mail_delete\",\"description\":\"PERMANENTLY delete messages ",
    "(\\\\Deleted + UID EXPUNGE of exactly these UIDs). Cannot be undone; ",
    "prefer mail_trash. Requires confirm = \\\"permanently-delete\\\", the ",
    "folder's uidvalidity and UIDPLUS on the server. The confirm word guards ",
    "against mistakes; it is not the user's approval, so ask the user first. ",
    "With MAILBEND_TYPESAFE on, it takes at most 50 UIDs, and Jev is first ",
    "asked whether each message should be kept: any high answer, or TypeSafe ",
    "failing, blocks the whole delete (the result has jev). A UID that did ",
    "not exist when Jev was asked is reported in missing, not deleted. Jev ",
    "can only block; it never approves a delete.\",",
    "\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"folder\":{\"type\":\"string\",\"description\":\"Folder ",
    "(IMAP mailbox) name. Default: INBOX.\"},\"uids\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":1},\"minItems\":1,",
    "\"description\":\"Message UIDs in the folder (from mail_search or ",
    "mail_get_new).\"},\"uidvalidity\":{\"type\":\"integer\",\"minimum\":1,",
    "\"description\":\"The folder's UIDVALIDITY returned with the UIDs ",
    "(mail_search, mail_get, mail_get_new). Checked in the same session as ",
    "the change; if the folder changed since, nothing is changed.\"},",
    "\"confirm\":{\"type\":\"string\",\"enum\":[\"permanently-delete\"]},",
    "\"dry_run\":{\"type\":\"boolean\",\"description\":\"Only show what this ",
    "call would do: return the IMAP commands, the SMTP sender and recipients ",
    "with sent_copy (whether MAILBEND_SAVE_SENT would save a Sent copy), or ",
    "the file it would use, with message and file contents as <N bytes>. ",
    "Nothing is changed, sent or saved. It is not a full pre-check: marking ",
    "and flagging make no connection, so a stale uidvalidity fails only the ",
    "real call, and a send does not check the daily limit. With ",
    "MAILBEND_TYPESAFE on, a send or delete still passes Jev's checks and ",
    "shows their verdict. Default false.\"}},\"required\":[\"uids\",",
    "\"uidvalidity\",\"confirm\"],\"additionalProperties\":false},",
