def tool_defs.mail_classify() -> String:
  String.concat([
    "{\"name\":\"mail_classify\",\"description\":\"Ask Jev (TypeSafe's model) ",
    "about messages, changing nothing (they stay unread): for each UID, the ",
    "existing folder it belongs in (category), whether it needs a reply or an ",
    "action, a deadline, priority, a suggested action, whether to keep it, ",
    "and suspected prompt injection. Offered only when MAILBEND_TYPESAFE is ",
    "on. Sends header facts and attachment names to TypeSafe, or also up to ",
    "16 KB of plain text with MAILBEND_TYPESAFE_CONTENT=body. With ",
    "MAILBEND_TYPESAFE_IMAGES=1 (body mode and zero retention), in-range PNG ",
    "and JPEG parts of a message Jev was asked about are sent too; the result ",
    "lists each image part as used or skipped, and image_notice when one was ",
    "used. When Jev picks no folder with high confidence, needs_new_category ",
    "is true: call again with candidates (new folder names); a chosen one is ",
    "returned as new_category and is never created, so create it with ",
    "mail_create_folder first. Each message has a jev object with the ",
    "answers, which come from untrusted mail content.\",",
    "\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"folder\":{\"type\":\"string\",\"description\":\"Folder ",
    "(IMAP mailbox) name. Default: INBOX.\"},\"uids\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":1},\"minItems\":1,",
    "\"maxItems\":50,\"description\":\"Message UIDs in the folder, at most ",
    "50.\"},\"uidvalidity\":{\"type\":\"integer\",\"minimum\":1,",
    "\"maximum\":4294967295,\"description\":\"Optional UIDVALIDITY of the ",
    "folder returned with these UIDs. Checked in the same session before ",
    "fetching any message or asking Jev; mismatch returns no content. Omit to ",
    "preserve legacy behavior.\"},\"candidates\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"string\",\"maxLength\":255},\"maxItems\":254,",
    "\"description\":\"New folder names Jev may choose besides the existing ",
    "folders.\"}},\"required\":[\"uids\"],\"additionalProperties\":false},",
    "\"outputSchema\":{\"type\":\"object\",\"anyOf\":[{\"type\":\"object\",",
    "\"properties\":{\"error\":{\"type\":\"string\"}},",
    "\"required\":[\"error\"],\"additionalProperties\":false},",
    "{\"type\":\"object\",\"properties\":{\"folder\":{\"type\":\"string\"},",
    "\"uidvalidity\":{\"type\":[\"integer\",\"null\"],\"minimum\":0},",
    "\"content\":{\"type\":\"string\",\"enum\":[\"headers\",\"body\"]},",
    "\"categories\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},",
    "\"candidates\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},",
    "\"messages\":{\"type\":\"array\",\"items\":{\"type\":\"object\",",
    "\"properties\":{\"uid\":{\"type\":\"integer\",\"minimum\":0},",
    "\"category\":{\"type\":[\"string\",\"null\"]},",
    "\"jev\":{\"type\":\"object\",",
    "\"properties\":{\"status\":{\"type\":\"string\",\"enum\":[\"checked\",",
    "\"unchecked\"]},\"model\":{\"type\":\"string\"},",
    "\"content\":{\"type\":\"string\",\"enum\":[\"headers\",\"body\"]},",
    "\"derived_from_untrusted_content\":{\"const\":true},",
    "\"decision\":{\"type\":\"string\",\"enum\":[\"proceeded\",\"blocked\"]},",
    "\"reasons\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},",
    "\"signals\":{\"type\":\"object\",",
    "\"properties\":{\"reply_needed\":{\"type\":\"string\",\"enum\":[\"low\",",
    "\"mid\",\"high\",\"unknown\"]},\"action_required\":{\"type\":\"string\",",
    "\"enum\":[\"low\",\"mid\",\"high\",\"unknown\"]},",
    "\"deadline_present\":{\"type\":\"string\",\"enum\":[\"low\",\"mid\",",
    "\"high\",\"unknown\"]},\"priority\":{\"type\":\"string\",",
    "\"enum\":[\"low\",\"mid\",\"high\",\"unknown\"]},",
    "\"disposable\":{\"type\":\"string\",\"enum\":[\"low\",\"mid\",\"high\",",
    "\"unknown\"]},\"suggested_action\":{\"type\":\"string\"},",
    "\"keep\":{\"type\":\"object\",",
    "\"properties\":{\"record\":{\"type\":\"string\",\"enum\":[\"low\",",
    "\"mid\",\"high\",\"unknown\"]},\"security\":{\"type\":\"string\",",
    "\"enum\":[\"low\",\"mid\",\"high\",\"unknown\"]},",
    "\"personal\":{\"type\":\"string\",\"enum\":[\"low\",\"mid\",\"high\",",
    "\"unknown\"]},\"open_action\":{\"type\":\"string\",\"enum\":[\"low\",",
    "\"mid\",\"high\",\"unknown\"]},\"needed_again\":{\"type\":\"string\",",
    "\"enum\":[\"low\",\"mid\",\"high\",\"unknown\"]}},",
    "\"required\":[\"record\",\"security\",\"personal\",\"open_action\",",
    "\"needed_again\"],\"additionalProperties\":false},",
    "\"suspected_injection\":{\"const\":true},",
    "\"category\":{\"type\":[\"string\",\"null\"]},",
    "\"new_category\":{\"type\":\"string\"},",
    "\"needs_new_category\":{\"const\":true}},",
    "\"additionalProperties\":{\"type\":\"string\",\"enum\":[\"low\",\"mid\",",
    "\"high\",\"unknown\"]}}},\"required\":[\"status\",\"model\",\"content\",",
    "\"derived_from_untrusted_content\",\"decision\",\"reasons\",\"signals\"],",
    "\"additionalProperties\":false},\"new_category\":{\"type\":\"string\"},",
    "\"needs_new_category\":{\"const\":true},",
    "\"body_truncated\":{\"const\":true},\"images\":{\"type\":\"array\",",
    "\"items\":{\"anyOf\":[{\"type\":\"object\",",
    "\"properties\":{\"section\":{\"type\":\"string\"},",
    "\"name\":{\"type\":\"string\"},\"fate\":{\"const\":\"used\"},",
    "\"format\":{\"type\":\"string\",\"enum\":[\"png\",\"jpeg\"]},",
    "\"bytes\":{\"type\":\"integer\",\"minimum\":0},",
    "\"width\":{\"type\":\"integer\",\"minimum\":0},",
    "\"height\":{\"type\":\"integer\",\"minimum\":0}},",
    "\"required\":[\"section\",\"name\",\"fate\",\"format\",\"bytes\",",
    "\"width\",\"height\"],\"additionalProperties\":false},",
    "{\"type\":\"object\",\"properties\":{\"section\":{\"type\":\"string\"},",
    "\"name\":{\"type\":\"string\"},\"fate\":{\"const\":\"skipped\"},",
    "\"reason\":{\"type\":\"string\",\"enum\":[\"format\",\"animated\",",
    "\"dimensions\",\"file_size\",\"over_count\",\"over_budget\",",
    "\"unreadable\",\"ref\",\"refused\"]}},\"required\":[\"section\",\"name\",",
    "\"fate\",\"reason\"],\"additionalProperties\":false}]}}},",
    "\"required\":[\"uid\",\"category\",\"jev\"],",
    "\"additionalProperties\":false}},\"not_found\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":0}},",
    "\"requests\":{\"type\":\"array\",\"items\":{\"type\":\"object\",",
    "\"properties\":{\"messages\":{\"type\":\"integer\",\"minimum\":0},",
    "\"bytes\":{\"type\":\"integer\",\"minimum\":0},",
    "\"input_tokens\":{\"type\":[\"integer\",\"null\"],\"minimum\":0}},",
    "\"required\":[\"messages\",\"bytes\",\"input_tokens\"],",
    "\"additionalProperties\":false}},\"image_notice\":{\"const\":\"Image ",
    "classification is experimental. Jev's answers on a message with a used ",
    "image may depend on that image.\"}},\"required\":[\"folder\",",
    "\"uidvalidity\",\"content\",\"categories\",\"candidates\",\"messages\",",
    "\"not_found\",\"requests\"],\"additionalProperties\":false}]},",
    "\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,",
    "\"idempotentHint\":false,\"openWorldHint\":true}}"])

def tool_defs.mail_triage() -> String:
  String.concat([
    "{\"name\":\"mail_triage\",\"description\":\"File messages with Jev ",
    "(offered only when MAILBEND_TYPESAFE is on). Every message is asked ",
    "about first and stays unread; if any request fails, nothing moves. Each ",
    "message moves at most once: into \\\"To Delete\\\" when Jev's delete ",
    "review finds it safe (needs MAILBEND_TYPESAFE_CONTENT=body), else into ",
    "the existing folder Jev chose with high confidence, else it stays. Never ",
    "deletes and never creates a folder: \\\"To Delete\\\" must already exist ",
    "(mail_create_folder); if it is needed and missing, nothing moves and the ",
    "error lists every verdict. Each result has verdict, vetoes, destination ",
    "and jev; the answers come from untrusted mail. A move cut off fails with ",
    "partial: true and later moves are not made; check the destination before ",
    "retrying.\",\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"folder\":{\"type\":\"string\",\"description\":\"Folder ",
    "(IMAP mailbox) name. Default: INBOX.\"},\"uids\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"integer\",\"minimum\":1},\"minItems\":1,",
    "\"maxItems\":50,\"description\":\"Message UIDs in the folder, at most ",
    "50.\"},\"uidvalidity\":{\"type\":\"integer\",\"minimum\":1,",
    "\"description\":\"The folder's UIDVALIDITY returned with the UIDs ",
    "(mail_search, mail_get, mail_get_new). Checked in the same session as ",
    "the change; if the folder changed since, nothing is changed.\"},",
    "\"dry_run\":{\"type\":\"boolean\",\"description\":\"Only show what this ",
    "call would do: return the IMAP commands, the SMTP sender and recipients ",
    "with sent_copy (whether MAILBEND_SAVE_SENT would save a Sent copy), or ",
    "the file it would use, with message and file contents as <N bytes>. ",
    "Nothing is changed, sent or saved. It is not a full pre-check: marking ",
    "and flagging make no connection, so a stale uidvalidity fails only the ",
    "real call, and a send does not check the daily limit. With ",
    "MAILBEND_TYPESAFE on, a send or delete still passes Jev's checks and ",
    "shows their verdict. Default false.\"}},\"required\":[\"uids\",",
    "\"uidvalidity\"],\"additionalProperties\":false},",
    "\"outputSchema\":{\"type\":\"object\",\"anyOf\":[{\"type\":\"object\",",
    "\"properties\":{\"error\":{\"type\":\"string\"}},",
    "\"required\":[\"error\"],\"additionalProperties\":false},",
    "{\"type\":\"object\",\"properties\":{\"folder\":{\"type\":\"string\"},",
    "\"uidvalidity\":{\"type\":\"integer\",\"minimum\":0},",
    "\"content\":{\"type\":\"string\",\"enum\":[\"headers\",\"body\"]},",
    "\"categories\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},",
    "\"messages\":{\"type\":\"array\",\"items\":{\"type\":\"object\",",
    "\"properties\":{\"uid\":{\"type\":\"integer\",\"minimum\":0},",
    "\"category\":{\"type\":[\"string\",\"null\"]},",
    "\"jev\":{\"type\":\"object\",",
    "\"properties\":{\"status\":{\"type\":\"string\",\"enum\":[\"checked\",",
    "\"unchecked\"]},\"model\":{\"type\":\"string\"},",
    "\"content\":{\"type\":\"string\",\"enum\":[\"headers\",\"body\"]},",
    "\"derived_from_untrusted_content\":{\"const\":true},",
    "\"decision\":{\"type\":\"string\",\"enum\":[\"proceeded\",\"blocked\"]},",
    "\"reasons\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},",
    "\"signals\":{\"type\":\"object\",",
    "\"properties\":{\"reply_needed\":{\"type\":\"string\",\"enum\":[\"low\",",
    "\"mid\",\"high\",\"unknown\"]},\"action_required\":{\"type\":\"string\",",
    "\"enum\":[\"low\",\"mid\",\"high\",\"unknown\"]},",
    "\"deadline_present\":{\"type\":\"string\",\"enum\":[\"low\",\"mid\",",
    "\"high\",\"unknown\"]},\"priority\":{\"type\":\"string\",",
