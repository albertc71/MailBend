# The MCP tool list that tools/list returns: each tool's name, description,
# input/output schemas and annotations, as JSON text.
#
# Generated by tools/gen-schema.py; edit that file, not this one, then run
# python3 tools/gen-schema.py. Each tool's JSON is split into short literals,
# because one long literal overflows the Bend compiler's stack.

import Base

def tool_defs.mail_probe() -> String:
  String.concat([
    "{\"name\":\"mail_probe\",\"description\":\"Check the connection: ",
    "verified TLS login, server capabilities (IDLE, MOVE, UIDPLUS) and ",
    "resolved special folders. Changes nothing.\",",
    "\"inputSchema\":{\"type\":\"object\",\"properties\":{},\"required\":[],",
    "\"additionalProperties\":false},\"outputSchema\":{\"type\":\"object\",",
    "\"anyOf\":[{\"type\":\"object\",",
    "\"properties\":{\"error\":{\"type\":\"string\"}},",
    "\"required\":[\"error\"],\"additionalProperties\":false},",
    "{\"type\":\"object\",\"properties\":{\"ok\":{\"const\":true},",
    "\"account\":{\"type\":\"string\"},\"imap_host\":{\"type\":\"string\"},",
    "\"tls_verified\":{\"const\":true},\"capabilities\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"string\"}},\"idle\":{\"type\":\"boolean\"},",
    "\"move\":{\"type\":\"boolean\"},\"uidplus\":{\"type\":\"boolean\"},",
    "\"special_use\":{\"type\":\"object\",",
    "\"properties\":{\"inbox\":{\"type\":[\"string\",\"null\"]},",
    "\"drafts\":{\"type\":[\"string\",\"null\"]},",
    "\"sent\":{\"type\":[\"string\",\"null\"]},",
    "\"trash\":{\"type\":[\"string\",\"null\"]},",
    "\"junk\":{\"type\":[\"string\",\"null\"]},",
    "\"archive\":{\"type\":[\"string\",\"null\"]}},\"required\":[\"inbox\",",
    "\"drafts\",\"sent\",\"trash\",\"junk\",\"archive\"],",
    "\"additionalProperties\":false},\"folder_count\":{\"type\":\"integer\",",
    "\"minimum\":0}},\"required\":[\"ok\",\"account\",\"imap_host\",",
    "\"tls_verified\",\"capabilities\",\"idle\",\"move\",\"uidplus\",",
    "\"special_use\",\"folder_count\"],\"additionalProperties\":false}]},",
    "\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,",
    "\"idempotentHint\":true,\"openWorldHint\":false}}"])

def tool_defs.mail_list_folders() -> String:
  String.concat([
    "{\"name\":\"mail_list_folders\",\"description\":\"List all IMAP folders ",
    "with their advertised special use (drafts, sent, trash, junk, archive). ",
    "Changes nothing.\",\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{},\"required\":[],\"additionalProperties\":false},",
    "\"outputSchema\":{\"type\":\"object\",\"anyOf\":[{\"type\":\"object\",",
    "\"properties\":{\"error\":{\"type\":\"string\"}},",
    "\"required\":[\"error\"],\"additionalProperties\":false},",
    "{\"type\":\"object\",\"properties\":{\"folders\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"object\",",
    "\"properties\":{\"name\":{\"type\":\"string\"},",
    "\"delimiter\":{\"type\":\"string\"},\"attributes\":{\"type\":\"array\",",
    "\"items\":{\"type\":\"string\"}},\"special_use\":{\"type\":[\"string\",",
    "\"null\"]},\"selectable\":{\"type\":\"boolean\"}},\"required\":[\"name\",",
    "\"delimiter\",\"attributes\",\"special_use\",\"selectable\"],",
    "\"additionalProperties\":false}}},\"required\":[\"folders\"],",
    "\"additionalProperties\":false}]},\"annotations\":{\"readOnlyHint\":true,",
    "\"destructiveHint\":false,\"idempotentHint\":true,",
    "\"openWorldHint\":false}}"])

def tool_defs.mail_search() -> String:
  String.concat([
    "{\"name\":\"mail_search\",\"description\":\"Search a folder, newest ",
    "first. Opens the folder read-only, so nothing is marked read. All ",
    "criteria are combined with AND. Pass next_cursor back as cursor with the ",
    "same folder and criteria for older matches. has_more=false and ",
    "next_cursor=null end traversal. Searches are re-evaluated; new arrivals ",
    "above the boundary are excluded. UID SEARCH still enumerates matches. ",
    "With MAILBEND_TYPESAFE on, each message also has a jev object with Jev's ",
    "notes (reply_needed, action_required, priority, category, ",
    "suggested_action, and suspected_injection when suspected), drawn from ",
    "untrusted mail content; its status is unchecked when TypeSafe failed.\",",
    "\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"folder\":{\"type\":\"string\",\"description\":\"Folder ",
    "(IMAP mailbox) name. Default: INBOX.\"},\"from\":{\"type\":\"string\"},",
    "\"to\":{\"type\":\"string\"},\"cc\":{\"type\":\"string\"},",
    "\"subject\":{\"type\":\"string\"},\"body\":{\"type\":\"string\",",
    "\"description\":\"Text in the body.\"},\"text\":{\"type\":\"string\",",
    "\"description\":\"Text anywhere in headers or body.\"},",
    "\"since\":{\"type\":\"string\",\"description\":\"On or after this date, ",
    "YYYY-MM-DD.\"},\"before\":{\"type\":\"string\",\"description\":\"Before ",
    "this date, YYYY-MM-DD.\"},\"unseen\":{\"type\":\"boolean\",",
    "\"description\":\"True selects unread; false selects read. Omit for ",
    "either. If seen is also given, the values must be opposite.\"},",
    "\"seen\":{\"type\":\"boolean\",\"description\":\"True selects read; ",
    "false selects unread. Omit for either. If unseen is also given, the ",
    "values must be opposite.\"},\"flagged\":{\"type\":\"boolean\",",
    "\"description\":\"True selects flagged; false selects unflagged. Omit ",
    "for either.\"},\"cursor\":{\"type\":\"string\",\"maxLength\":4096,",
    "\"description\":\"Opaque continuation from next_cursor; at most 4096 ",
    "characters.\"},\"limit\":{\"type\":\"integer\",\"minimum\":1,",
    "\"maximum\":200,\"description\":\"Default 20.\"},",
    "\"projection\":{\"type\":\"string\",\"enum\":[\"full\",\"text\",\"html\",",
    "\"metadata\"],\"description\":\"Body fields to return; default full ",
    "preserves text and HTML. text omits html, html omits text, metadata ",
    "omits both. Headers, summaries, identity, completeness and Jev stay ",
    "unchanged. Selected-part content follows its MIME type: text keeps ",
    "text/* except text/html, html keeps text/html, metadata omits content. ",
    "Does not change fetching or Jev input.\"},",
    "\"max_response_bytes\":{\"type\":\"integer\",\"minimum\":1,",
    "\"maximum\":16777216,\"description\":\"Optional UTF-8 byte budget for ",
    "shared result JSON, including JSON escaping; excludes CLI newline and ",
    "MCP envelope/escaping. No default limit. Only body strings are ",
    "shortened; selected binary content is kept whole or replaced by empty ",
    "valid base64, never sliced. Selected-part response.content_complete ",
    "describes returned content; complete remains fetched-part completeness. ",
    "All summaries/cursors/Jev results remain; an impossible budget is an ",
    "error (errors are outside the budget). Retry with a larger budget or ",
    "smaller limit and the same checkpoint. response.output_truncated is ",
    "separate from fetched-message truncated.\"}},\"required\":[],",
    "\"additionalProperties\":false},\"outputSchema\":{\"type\":\"object\",",
    "\"anyOf\":[{\"type\":\"object\",",
    "\"properties\":{\"error\":{\"type\":\"string\"}},",
    "\"required\":[\"error\"],\"additionalProperties\":false},",
    "{\"type\":\"object\",\"properties\":{\"folder\":{\"type\":\"string\"},",
    "\"uidvalidity\":{\"type\":[\"integer\",\"null\"],\"minimum\":0},",
    "\"total\":{\"type\":\"integer\",\"minimum\":0},",
    "\"messages\":{\"type\":\"array\",\"items\":{\"type\":\"object\",",
    "\"properties\":{\"date\":{\"type\":\"string\"},",
    "\"from\":{\"type\":\"string\"},\"to\":{\"type\":\"string\"},",
    "\"cc\":{\"type\":\"string\"},\"subject\":{\"type\":\"string\"},",
    "\"message_id\":{\"type\":\"string\"},",
    "\"internal_date\":{\"type\":\"string\"},\"uid\":{\"type\":\"integer\",",
    "\"minimum\":0},\"size\":{\"type\":\"integer\",\"minimum\":0},",
    "\"flags\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},",
    "\"seen\":{\"type\":\"boolean\"},\"flagged\":{\"type\":\"boolean\"},",
    "\"jev\":{\"type\":\"object\",",
    "\"properties\":{\"status\":{\"type\":\"string\",\"enum\":[\"checked\",",
    "\"unchecked\"]},\"model\":{\"type\":\"string\"},",
    "\"content\":{\"type\":\"string\",\"enum\":[\"headers\",\"body\"]},",
    "\"derived_from_untrusted_content\":{\"const\":true},",
    "\"decision\":{\"type\":\"string\",\"enum\":[\"proceeded\",\"blocked\"]},",
    "\"reasons\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},",
