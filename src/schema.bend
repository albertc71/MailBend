def tool_defs.mail_create_folder() -> String:
  String.concat([
    "{\"name\":\"mail_create_folder\",\"title\":\"Create a mail folder\",",
    "\"description\":\"Create a folder and subscribe to it (if only the ",
    "subscription fails, the call succeeds with subscribed: false; do not ",
    "retry); on iCloud a folder works as a label (see mail_label). The parent ",
    "folder must already exist, the name must not be taken, and it cannot be ",
    "INBOX, Drafts, Sent, Trash, Junk, Archive (by any usual name), a ",
    "configured or advertised role folder, or inside one. The review folder ",
    "\\\"To Delete\\\" may be created only at top level. There is no tool to ",
    "delete a folder: do that in Apple Mail or iCloud.com.\",",
    schema_piece.p0011(),
    "\"properties\":{\"name\":{\"type\":\"string\",\"description\":\"The new ",
    "folder's full name, levels separated by the server's delimiter (see ",
    "mail_list_folders).\"},\"dry_run\":{\"type\":\"boolean\",",
    schema_piece.p0424(),
    schema_piece.p0425(),
    schema_piece.p0426(),
    schema_piece.p0427(),
    schema_piece.p0428(),
    schema_piece.p0429(),
    schema_piece.p0430(),
    schema_piece.p0431(),
    "false.\"}},\"required\":[\"name\"],\"additionalProperties\":false},",
    schema_piece.p0001(),
    schema_piece.p0002(),
    schema_piece.p0003(),
    schema_piece.p0004(),
    "\"folder\":{\"type\":\"string\"},\"subscribed\":{\"type\":\"boolean\"},",
    "\"note\":{\"type\":\"string\"}},\"required\":[\"ok\",\"folder\",",
    "\"subscribed\"],\"additionalProperties\":false},{\"type\":\"object\",",
    schema_piece.p0416(),
    schema_piece.p0413(),
    schema_piece.p0423(),
    schema_piece.p0417(),
    schema_piece.p0376()])

def tool_defs.mail_rename_folder() -> String:
  String.concat([
    "{\"name\":\"mail_rename_folder\",\"title\":\"Rename a mail folder\",",
    "\"description\":\"Rename a folder together with its subfolders, and move ",
    "the subscriptions of the folder and of its subscribed subfolders to ",
    "their new names. If only the subscriptions fail, the call succeeds with ",
    "subscribed: false; do not retry. If the connection drops before the ",
    "answer, the folder may have been renamed: list folders before retrying. ",
    "The same name rules as mail_create_folder apply to the new name and to ",
    "every subfolder's new path, and a folder that is or contains INBOX, ",
    "Drafts, Sent, Trash, Junk, Archive or another role folder cannot be ",
    "renamed.\",\"inputSchema\":{\"type\":\"object\",",
    "\"properties\":{\"from\":{\"type\":\"string\",\"description\":\"Current ",
    "full folder name.\"},\"to\":{\"type\":\"string\",\"description\":\"New ",
    "full folder name; its parent must already exist.\"},",
    schema_piece.p0381(),
    schema_piece.p0382(),
    schema_piece.p0383(),
    schema_piece.p0384(),
    schema_piece.p0385(),
    schema_piece.p0386(),
    schema_piece.p0387(),
    schema_piece.p0388(),
    "shows their verdict. Default false.\"}},\"required\":[\"from\",\"to\"],",
    schema_piece.p0008(),
    schema_piece.p0009(),
    schema_piece.p0002(),
    schema_piece.p0003(),
    schema_piece.p0004(),
    schema_piece.p0051(),
    "\"subscribed\":{\"type\":\"boolean\"},\"note\":{\"type\":\"string\"}},",
    "\"required\":[\"ok\",\"from\",\"to\",\"subscribed\"],",
    schema_piece.p0098(),
    schema_piece.p0416(),
    schema_piece.p0413(),
    schema_piece.p0423(),
    schema_piece.p0415(),
    schema_piece.p0376()])

