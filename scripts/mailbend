#!/usr/bin/env sh
# MailBend launcher: runs the compiled core (bin/mailbend-core) with the TLS
# helper, the attachment reader and the TypeSafe helper next to it. Falls back to
# `bend main.bend` (slower start) when the core was not compiled.
# MCP uses the stdio helper to adapt inherited sockets before starting the core.
# Usage: scripts/mailbend mcp | tools | call <tool> [json or -] | diagnose [--imap] [--smtp] | setup | hook claude-pretooluse | version
set -eu
ulimit -c 0
# Bend may reuse a closed fd 0 for an internal pipe before opening /dev/stdin.
if [ "$#" -eq 2 ] && [ "$1" = hook ] && [ "$2" = claude-pretooluse ]; then
  if [ ! -e /dev/stdin ]; then
    printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"ask","permissionDecisionReason":"MailBend could not read this tool call. Check its arguments before continuing."}}'
    exit 0
  fi
fi
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
: "${MAILBEND_TLS_HELPER:=$root/bin/mailbend-tls}"
: "${MAILBEND_ATTACH_HELPER:=$root/bin/mailbend-attach}"
: "${MAILBEND_TYPESAFE_HELPER:=$root/bin/mailbend-typesafe}"
export MAILBEND_TLS_HELPER MAILBEND_ATTACH_HELPER MAILBEND_TYPESAFE_HELPER
export BEND_NO_TELEMETRY=1
case "${1:-}:${2:-}" in
  setup:--provider|setup:--email|setup:--help|hook:claude-pretooluse) ;;
  *)
    if [ -n "${MAILBEND_CA_FILE:-}" ]; then
      echo "mailbend: warning: MAILBEND_CA_FILE replaces the system trust store; it is meant for local tests" >&2
    fi
    if [ "${SSL_CERT_FILE+x}" = x ] || [ "${SSL_CERT_DIR+x}" = x ]; then
      echo "mailbend: warning: SSL_CERT_FILE or SSL_CERT_DIR can replace the system trust store for both network helpers" >&2
    fi
    ;;
esac
if [ "$#" -eq 1 ] && [ "$1" = mcp ]; then
  if [ ! -x "$root/bin/mailbend-stdio" ]; then
    echo "mailbend: stdio helper is missing; run scripts/install.sh" >&2
    exit 2
  fi
  exec "$root/bin/mailbend-stdio" mcp
fi
if [ -x "$root/bin/mailbend-core" ]; then
  exec "$root/bin/mailbend-core" "$@"
fi
if command -v bend >/dev/null 2>&1; then
  exec bend "$root/main.bend" -- "$@"
fi
if [ -x "$HOME/.bend/bin/bend" ]; then
  exec "$HOME/.bend/bin/bend" "$root/main.bend" -- "$@"
fi
echo "mailbend: not built; run scripts/install.sh" >&2
exit 2
