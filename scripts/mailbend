#!/usr/bin/env sh
# MailBend launcher: pin one complete managed generation for this session.
# Only legacy layouts may fall back to interpreting main.bend.
# MCP uses the stdio helper to adapt inherited sockets before starting the core.
# Usage: scripts/mailbend mcp | tools | call <tool> [json or -] | diagnose [--imap] [--smtp] [--report] | setup | hook claude-pretooluse | version
set -eu
ulimit -c 0
# Bend may reuse a closed fd 0 for an internal pipe before opening /dev/stdin.
if [ "$#" -eq 2 ] && [ "$1" = hook ] && [ "$2" = claude-pretooluse ]; then
  if [ ! -e /dev/stdin ]; then
    printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"ask","permissionDecisionReason":"MailBend could not read this tool call. Check its arguments before continuing."}}'
    exit 0
  fi
fi
root=$(CDPATH= cd -P -- "$(dirname -- "$0")/.." && pwd -P)
. "$root/scripts/install-layout.sh"
selected_bin=$root/bin
managed=0
if mb_exists "$root/.mailbend-install" || [ -L "$root/bin" ] || mb_exists "$root/bin.prev"; then
  mb_root_open
  mb_capture
  [ "$MB_KIND" != bootstrap ] || mb_fail "installation is incomplete; rerun scripts/install.sh"
  selected_bin=$MB_GENERATION
  managed=1
fi
: "${MAILBEND_TLS_HELPER:=$selected_bin/mailbend-tls}"
: "${MAILBEND_ATTACH_HELPER:=$selected_bin/mailbend-attach}"
: "${MAILBEND_TYPESAFE_HELPER:=$selected_bin/mailbend-typesafe}"
export MAILBEND_TLS_HELPER MAILBEND_ATTACH_HELPER MAILBEND_TYPESAFE_HELPER
export BEND_NO_TELEMETRY=1
case "${1:-}:${2:-}" in
  setup:--provider|setup:--email|setup:--help|hook:claude-pretooluse) ;;
  *)
    if [ -n "${MAILBEND_CA_FILE:-}" ]; then
      echo "mailbend: warning: MAILBEND_CA_FILE replaces the system trust store; it is meant for local tests" >&2
    fi
    if [ "${SSL_CERT_FILE+x}" = x ] || [ "${SSL_CERT_DIR+x}" = x ]; then
      echo "mailbend: warning: SSL_CERT_FILE or SSL_CERT_DIR can replace the system trust store for both network helpers" >&2
    fi
    ;;
esac
if [ "$managed" = 1 ]; then
  mb_root_same
  mb_restore_locale
  # A directory descriptor is not a lifetime lock and is not needed by the core.
  exec 8<&-
fi
if [ "$#" -eq 1 ] && [ "$1" = mcp ]; then
  if [ ! -x "$selected_bin/mailbend-stdio" ]; then
    echo "mailbend: stdio helper is missing; run scripts/install.sh" >&2
    exit 2
  fi
  exec "$selected_bin/mailbend-stdio" mcp
fi
if [ -x "$selected_bin/mailbend-core" ]; then
  exec "$selected_bin/mailbend-core" "$@"
fi
[ "$managed" = 0 ] || mb_fail "compiled core is missing; rerun scripts/install.sh"
if command -v bend >/dev/null 2>&1; then
  exec bend "$root/main.bend" -- "$@"
fi
if [ -x "$HOME/.bend/bin/bend" ]; then
  exec "$HOME/.bend/bin/bend" "$root/main.bend" -- "$@"
fi
echo "mailbend: not built; run scripts/install.sh" >&2
exit 2
