# The length-only counter matches every U32-backed Char escape atom.

import Base
import ./json-size-arithmetic.bend as Arithmetic
import ../../src/codec.bend as C
import ../../src/json.bend as J

def atom_exact.if(ctrl: Bool, +u: U32, +c: Char)
  -> {C.utf8_len(J.esc_char.if(ctrl, u, c)) == J.esc_bytes.if(ctrl, u, c) : U32}:
  match ctrl:
    case True{}:
      {==}
    case False{}:
      Arithmetic.add_zero(C.utf8_width(Char.to_u32(c)))

# Explicit positive bit cases avoid the compiler's negative literal-pattern
# refinement: each fallback path differs from all five special characters.
