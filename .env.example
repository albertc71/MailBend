# Identity and secret: set these as agent secrets / environment variables.
MAILBEND_EMAIL=you@icloud.com
MAILBEND_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Server endpoints: iCloud defaults. Override for a compatible provider using
# password-authenticated IMAP with implicit TLS and SMTP with STARTTLS.
MAILBEND_IMAP_HOST=imap.mail.me.com
MAILBEND_IMAP_PORT=993
MAILBEND_SMTP_HOST=smtp.mail.me.com
MAILBEND_SMTP_PORT=587

# Optional folder roles: exact decoded LIST names, including namespace prefixes
# (only INBOX is case-insensitive). Nonempty overrides take precedence over
# advertised SPECIAL-USE roles, then conventional names. Empty uses discovery.
# Invalid overrides fail; ambiguous or unselectable targets never trigger a
# guessed write. MailBend does not create missing folders.
MAILBEND_DRAFTS_FOLDER=
MAILBEND_TRASH_FOLDER=
MAILBEND_SENT_FOLDER=
MAILBEND_JUNK_FOLDER=
MAILBEND_ARCHIVE_FOLDER=

# Network resolution and timeouts.
# Optional HTTPS DNS resolver. Empty/unset uses system DNS. The cloud launcher
# defaults this to https://cloudflare-dns.com/dns-query (fresh each session).
MAILBEND_DOH_URL=
# Emergency numeric connection destinations; keep *_HOST as the TLS name.
# One bare IPv4/IPv6 address each, no port. Overrides DoH for that service.
# These do not refresh automatically; normally use DoH instead.
MAILBEND_IMAP_CONNECT_IP=
MAILBEND_SMTP_CONNECT_IP=
# DNS+TCP connection budget and per-read timeout in milliseconds (default 30000).
MAILBEND_TIMEOUT_MS=30000

# Mail safety and attachment access.
# Refuse every tool that changes mail or sends it (1/true).
MAILBEND_READ_ONLY=
# Directory whose regular files may be attached (paths are relative to it or
# absolute inside it; symlinks are refused); attachments are off when unset.
MAILBEND_ATTACH_DIR=

# Native helper paths and test trust store.
# Absolute path of the TLS helper (a relative path is refused); scripts/mailbend
# sets it to its own bin/mailbend-tls.
MAILBEND_TLS_HELPER=
# Absolute path of the attachment reader; scripts/mailbend sets it to its own
# bin/mailbend-attach.
MAILBEND_ATTACH_HELPER=
# Replaces the system trust store for mail TLS and DoH (local tests only).
MAILBEND_CA_FILE=
