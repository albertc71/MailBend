# Identity and secret: set these as agent secrets / environment variables.
MAILBEND_EMAIL=you@icloud.com
MAILBEND_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional.
MAILBEND_IMAP_HOST=imap.mail.me.com
MAILBEND_IMAP_PORT=993
MAILBEND_SMTP_HOST=smtp.mail.me.com
MAILBEND_SMTP_PORT=587
# Refuse every tool that changes mail or sends it (1/true).
MAILBEND_READ_ONLY=
# Directory whose regular files may be attached; attachments are off when unset.
MAILBEND_ATTACH_DIR=
# Per-read network timeout in milliseconds (default 30000).
MAILBEND_TIMEOUT_MS=30000
# Path of the TLS helper; scripts/mailbend sets it to bin/mailbend-tls.
MAILBEND_TLS_HELPER=
# Replaces the system trust store (for the local test server only).
MAILBEND_CA_FILE=
