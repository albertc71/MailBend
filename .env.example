# Identity and secret: set these as agent secrets / environment variables.
MAILBEND_EMAIL=you@icloud.com
MAILBEND_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Or, instead of MAILBEND_APP_PASSWORD (never both): the absolute path of a
# file you own with mode 600 holding only the password, outside
# MAILBEND_ATTACH_DIR. Keeps the password out of every environment.
MAILBEND_PASSWORD_FILE=

# Server endpoints: iCloud defaults. Override for a compatible provider using
# password-authenticated IMAP with implicit TLS and SMTP with STARTTLS.
MAILBEND_IMAP_HOST=imap.mail.me.com
MAILBEND_IMAP_PORT=993
MAILBEND_SMTP_HOST=smtp.mail.me.com
MAILBEND_SMTP_PORT=587

# Optional folder roles: exact decoded LIST names, including namespace prefixes
# (only INBOX is case-insensitive). Nonempty overrides take precedence over
# advertised SPECIAL-USE roles, then conventional names. Empty uses discovery.
# Invalid overrides fail; ambiguous or unselectable targets never trigger a
# guessed write. MailBend does not create missing folders.
MAILBEND_DRAFTS_FOLDER=
MAILBEND_TRASH_FOLDER=
MAILBEND_SENT_FOLDER=
MAILBEND_JUNK_FOLDER=
MAILBEND_ARCHIVE_FOLDER=

# Network resolution and timeouts.
# Optional HTTPS DNS resolver. Empty/unset uses system DNS. The cloud launcher
# defaults this to https://cloudflare-dns.com/dns-query (fresh each session).
MAILBEND_DOH_URL=
# Emergency numeric connection destinations; keep *_HOST as the TLS name.
# One bare IPv4/IPv6 address each, no port. Overrides DoH for that service.
# These do not refresh automatically; normally use DoH instead.
MAILBEND_IMAP_CONNECT_IP=
MAILBEND_SMTP_CONNECT_IP=
# DNS+TCP connection budget and per-read timeout in milliseconds (default 30000).
MAILBEND_TIMEOUT_MS=30000

# Mail safety and attachment access.
# Switches take 1/true or 0/false/empty; any other value fails every tool.
# Refuse (and do not list) every tool that changes mail or sends it.
MAILBEND_READ_ONLY=
# Allow changes but never send: mail_send is refused and not listed, replies
# and forwards only with as_draft. A person sends each message from Drafts.
MAILBEND_DRAFTS_ONLY=
# A dedicated directory whose regular files may be attached (paths are
# relative to it or absolute inside it; symlinks, hard-linked files, devices
# and FIFOs are refused). /, your home directory and directories holding
# .ssh, .gnupg, .aws, .config or .git, or lying inside one, are refused.
# Attachments are off when unset.
MAILBEND_ATTACH_DIR=
# Absolute path of a dedicated directory mail_get_attachment saves files in,
# as new files (never replacing one) of mode 0600. Refused: everything refused
# for MAILBEND_ATTACH_DIR, a directory that is, contains or lies inside
# MAILBEND_ATTACH_DIR, anything under ~/.config, ~/.local/bin or
# ~/.local/share/applications, any autostart or systemd directory, and any
# directory in PATH. Downloads are off when unset.
MAILBEND_DOWNLOAD_DIR=

# Sending (mail_send, and replies and forwards that are not drafts). A malformed
# value refuses every send; drafts and reads are unaffected.
# Comma-separated exact addresses and @domain entries (that domain only, not
# subdomains). Any other recipient refuses the whole message. Empty: no allowlist.
MAILBEND_ALLOWED_RECIPIENTS=
# Positive number of sends per UTC day, counted before SMTP (a failed send still
# counts). Empty: no limit.
MAILBEND_MAX_SENDS_PER_DAY=
# Absolute directory of the send count (the file "sends"; deleting it resets the
# count). Empty: $XDG_STATE_HOME/mailbend, else ~/.local/state/mailbend.
MAILBEND_STATE_DIR=
# 1/true appends each sent message to the Sent folder unless the server already
# filed it there; 0/false/empty does not. iCloud does not file SMTP-sent mail in
# Sent, so set 1 there.
MAILBEND_SAVE_SENT=

# Jev, TypeSafe's model (docs/JEV.md). These settings are checked even when it
# is off, and a bad value fails every tool. 1/true turns it on: reads add Jev's
# notes, sends and permanent deletes can be blocked by it (TypeSafe failing
# blocks them too), and mail_classify and mail_triage are listed (read-only
# mode hides mail_triage). Outside those two tools Jev can only block or add
# notes; in them it only chooses among existing folders and To Delete. It never
# approves an action, deletes mail, creates a mailbox or adds a recipient.
# Message facts then go to api.typesafe.ai. 0/false/empty: off, no tool asks it.
MAILBEND_TYPESAFE=
# Absolute path of a file you own with mode 600 holding only the TypeSafe key
# (the same rules as MAILBEND_PASSWORD_FILE). Only mailbend-typesafe reads it.
# Never put the key in MAILBEND_TYPESAFE_API_KEY: setting that variable, even
# empty, fails every tool.
MAILBEND_TYPESAFE_KEY_FILE=
# headers (or empty): header facts and attachment names only. body: also up to
# 16 KB of each message's plain text (list reads still send headers only),
# which needs MAILBEND_TYPESAFE_ZERO_RETENTION.
MAILBEND_TYPESAFE_CONTENT=
# 1/true states that your TypeSafe account has a zero-retention plan.
# MailBend cannot verify this statement.
MAILBEND_TYPESAFE_ZERO_RETENTION=

# Native helper paths and test trust store.
# Absolute path of the TLS helper (a relative path is refused); scripts/mailbend
# sets it to its own bin/mailbend-tls.
MAILBEND_TLS_HELPER=
# Absolute path of the attachment reader and download writer; scripts/mailbend
# sets it to its own bin/mailbend-attach.
MAILBEND_ATTACH_HELPER=
# Absolute path of the TypeSafe helper; scripts/mailbend sets it to its own
# bin/mailbend-typesafe.
MAILBEND_TYPESAFE_HELPER=
# Replaces the system trust store for mail TLS, DoH and TypeSafe. Local tests only:
# never set it in production (scripts/mailbend warns when it is set).
MAILBEND_CA_FILE=
