[Unit]
Description=Save one queued MailBend follow-up as a draft

[Service]
Type=oneshot
TimeoutStartSec=120
KillMode=control-group
UMask=0077
EnvironmentFile=%h/.config/mailbend-recipes/account.env
Environment=MAILBEND_PASSWORD_FILE=%h/.config/mailbend-recipes/password
Environment=MAILBEND_DRAFTS_ONLY=1
Environment=MAILBEND_TYPESAFE=0
Environment=MAILBEND_RECIPE_STATE=%h/.local/state/mailbend-recipes/drafts
Environment=MAILBEND_RECIPE_QUEUE=%h/.local/state/mailbend-recipes/queue
UnsetEnvironment=MAILBEND_APP_PASSWORD
ExecStart=/bin/bash %h/src/MailBend/examples/scheduled/draft-follow-ups.sh
